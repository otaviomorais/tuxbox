#!/system/bin/sh
# ensure-x11-clients — Arch-only: garante as libs de CLIENTE X11 que os
# graficos abrem em tempo de execucao para conseguir criar janela no $DISPLAY.
#
# POR QUE SO ARCH:
# O vkmark upstream monta o backend X11 como PLUGIN CARREGAVEL, nao linkado no
# binario (src/meson.build):
#     if build_xcb_ws
#         xcb_ws = shared_module('xcb', ... dependencies: [vulkan_dep, xcb_dep, xcb_icccm_dep] ...)
#     endif
# No Arch o pacote xcb-util-wm e' dependencia OPCIONAL ("for X11 support"), ou
# seja, `pacman -S vkmark` instala o plugin mas NAO as libs que ele dlopen().
# Resultado: o Vulkan roda na GPU (surface headless) e nada aparece no X11.
#
# POR QUE EXECUTAR DENTRO DO CONTAINER (--in-container):
# v3.43/v3.44 tentavam `chroot $ROOTFS pacman ...` no host, copiando o
# pacman.conf e sobrescrevendo o --cachedir. Esse caminho falhava em silencio
# (o --cachedirOverrides owner mudava para root e o DownloadUser=alpm perdia a
# permissao de escrita) e o usuario tinha que digitar o pacman -S na mao. A
# correcao e usar o MESMO comando que funciona, sem chroot e sem overrides:
#     pacman -S --needed --noconfirm xcb-util-wm libxcb
# dentro do proprio container, com o conf dele. Modo host = copia o script
# para o rootfs e entra no chroot chamando esse modo.
#
# Nao mexe em nenhuma outra distro: sem pacman no rootfs e' no-op.
# Uso:
#   ensure-x11-clients <rootfs> [minimal|full]      (no host: copia e usa chroot)
#   ensure-x11-clients --in-container [minimal|full] (ja dentro do container)

set -u

MODE="minimal"
ROOTFS=""
IN_CONTAINER=0

if [ "${1:-}" = "--in-container" ]; then
    IN_CONTAINER=1
    MODE="${2:-minimal}"
else
    ROOTFS="${1:-}"
    MODE="${2:-minimal}"
fi

case "$MODE" in
    full|minimal) ;;
    *) MODE="minimal" ;;
esac

LIB_PKGS="xcb-util-wm libxcb"

# Arquivos que provam que as libs criticas ja estao la.
lib_present() {
    _base="$1"
    for _p in \
        "$ROOTFS/usr/lib/$_base".* \
        "$ROOTFS/lib/$_base".* \
        "$ROOTFS/usr/lib/aarch64-linux-gnu/$_base".* \
        "$ROOTFS/usr/lib/arm-linux-gnueabihf/$_base".* \
        "$ROOTFS/usr/lib/musl/$_base".*
    do
        [ -e "$_p" ] && return 0
    done
    return 1
}

bin_present() {
    for _b in "$ROOTFS/usr/bin/$1" "$ROOTFS/bin/$1" "$ROOTFS/usr/local/bin/$1"; do
        [ -x "$_b" ] && return 0
    done
    return 1
}

if [ "$IN_CONTAINER" = "0" ]; then
    # ---------- modo host: instala o script no container e entra nele ----------
    [ -n "$ROOTFS" ] || { echo "uso: ensure-x11-clients <rootfs> [minimal|full]"; exit 2; }
    [ -d "$ROOTFS" ] || exit 2
    # Arch apenas. Qualquer outra distro sai intacta.
    [ -x "$ROOTFS/usr/bin/pacman" ] || { echo "skip: nao-arch"; exit 0; }

    _self="$0"
    case "$_self" in
        /*) : ;;
        *) _self="$(CDPATH= cd -- "$(dirname -- "$_self")" 2>/dev/null && pwd)/$(basename -- "$_self")" ;;
    esac
    [ -r "$_self" ] || { echo "FALHOU: nao achei o proprio script ($_self)"; exit 1; }

    mkdir -p "$ROOTFS/usr/local/bin" 2>/dev/null || {
        echo "FALHOU: nao consegui criar $ROOTFS/usr/local/bin"; exit 1; }
    # tmp + mv: nunca executa um arquivo sendo reescrito.
    cp "$_self" "$ROOTFS/usr/local/bin/.tuxbox-x11-clients.new" 2>/dev/null || {
        echo "FALHOU: nao consegui copiar o helper para o container"; exit 1; }
    chmod 755 "$ROOTFS/usr/local/bin/.tuxbox-x11-clients.new" 2>/dev/null || true
    mv -f "$ROOTFS/usr/local/bin/.tuxbox-x11-clients.new" \
          "$ROOTFS/usr/local/bin/tuxbox-x11-clients" 2>/dev/null || {
        echo "FALHOU: nao consegui gravar o helper no container"; exit 1; }

    # Invoca pelo /bin/sh DO CONTAINER, nunca pelo shebang: o shebang deste
    # arquivo e' #!/system/bin/sh (o shell do Android), que nao existe dentro
    # do container depois do pivot_root — o script seria "not found".
    _csh=""
    for _c in /bin/sh /usr/bin/sh /bin/bash; do
        if [ -x "$ROOTFS$_c" ]; then _csh="$_c"; break; fi
    done
    if [ -z "$_csh" ]; then
        echo "FALHOU: container sem shell em /bin/sh para rodar o helper"
        exit 1
    fi
    chroot "$ROOTFS" "$_csh" /usr/local/bin/tuxbox-x11-clients --in-container "$MODE"
    exit $?
fi

# ---------- modo in-container ----------
ROOTFS=""
mkdir -p /var/log 2>/dev/null || true
LOG="/var/log/tuxbox-x11-clients.log"
log() { printf '[x11-clients] %s\n' "$*" >>"$LOG" 2>/dev/null || true; }

# Arch apenas (o modo host ja filtrou, mas o boot pode chamar direto).
if [ ! -x /usr/bin/pacman ]; then
    echo "skip: nao-arch"
    exit 0
fi

# 1) Conf do container, normalizado no lugar (mesma politica do ensure-pacman):
#    - DisableSandbox: pacman 7 exige Landlock no download, ausente em Android.
#    - SigLevel ... TrustAll: a cadeia de confianca das chaves ARM fica
#      "marginal" no container; sem TrustAll o pacman REJEITA a assinatura.
#    Idempotente: so muda se ainda nao estiver como queremos.
relax_conf() {
    _c="/etc/pacman.conf"
    [ -f "$_c" ] || { log "AVISO: /etc/pacman.conf ausente"; return 1; }
    _changed=0
    if ! grep -q '^[[:space:]]*DisableSandbox' "$_c" 2>/dev/null; then
        if grep -q '^\[options\]' "$_c" 2>/dev/null; then
            sed -i '/^\[options\]/a DisableSandbox' "$_c" 2>/dev/null && _changed=1
        else
            printf '\n[options]\nDisableSandbox\n' >>"$_c" 2>/dev/null && _changed=1
        fi
    fi
    if grep -q '^[[:space:]]*SigLevel[[:space:]]*=' "$_c" 2>/dev/null; then
        grep -q '^[[:space:]]*SigLevel[[:space:]]*=.*TrustAll' "$_c" 2>/dev/null || {
            sed -i 's/^[[:space:]]*SigLevel[[:space:]]*=.*/SigLevel = Required DatabaseOptional TrustAll/' \
                "$_c" 2>/dev/null && _changed=1
        }
    else
        printf 'SigLevel = Required DatabaseOptional TrustAll\n' >>"$_c" 2>/dev/null && _changed=1
    fi
    if grep -q '^[[:space:]]*LocalFileSigLevel[[:space:]]*=' "$_c" 2>/dev/null; then
        sed -i 's/^[[:space:]]*LocalFileSigLevel[[:space:]]*=.*/LocalFileSigLevel = Optional/' \
            "$_c" 2>/dev/null || true
    else
        printf 'LocalFileSigLevel = Optional\n' >>"$_c" 2>/dev/null || true
    fi
    [ "$_changed" = "1" ] && log "pacman.conf normalizado (DisableSandbox/TrustAll)"
    return 0
}
relax_conf

# 2) Keyring: sem GPGDir o pacman aborta antes de baixar.
if [ ! -d /etc/pacman.d/gnupg ] && [ -x /usr/bin/pacman-key ]; then
    log "keyring ausente — pacman-key --init"
    /usr/bin/pacman-key --init >>"$LOG" 2>&1 || true
    /usr/bin/pacman-key --populate archlinuxarm >>"$LOG" 2>&1 || true
    /usr/bin/pacman-key --lsign-key \
        68B3537F39A313B3E574D06777193F152BDBE6A6 >>"$LOG" 2>&1 || true
fi

# 3) Libs criticas — o proprio comando que funciona, sem overrides.
MISSING=""
lib_present libxcb-icccm.so || MISSING="$MISSING xcb-util-wm"
lib_present libxcb.so || MISSING="$MISSING libxcb"

rc=0
if [ -n "$MISSING" ]; then
    log "instalando:$MISSING"
    # shellcheck disable=SC2086
    if /usr/bin/pacman -S --needed --noconfirm $LIB_PKGS >>"$LOG" 2>&1; then
        rc=0
    else
        rc=1
        log "pacman -S falhou (rc=$?)"
    fi
fi

libs_ok=0
if lib_present libxcb-icccm.so && lib_present libxcb.so; then
    libs_ok=1
else
    rc=1
fi

# 4) Modo full: programas de X11 (WM + clientes de teste). Cada um e' sondado
#    com `pacman -Si`; o repo do container pode nao ter o mesmo conjunto do
#    Arch oficial, e o que faltar e' pulado com log.
extras_note=""
if [ "$MODE" = "full" ] && [ "$libs_ok" = "1" ]; then
    _want=""
    _skip=""
    for _pair in openbox:openbox xterm:xterm xorg-xclock:xclock; do
        _pkg="${_pair%%:*}"
        _bin="${_pair#*:}"
        bin_present "$_bin" && continue
        if /usr/bin/pacman -Si "$_pkg" >>"$LOG" 2>&1; then
            _want="$_want $_pkg"
        else
            log "extra $_pkg: ausente no repo deste container — pulado"
            _skip="$_skip $_pkg"
        fi
    done
    if [ -n "$_want" ]; then
        # shellcheck disable=SC2086
        if /usr/bin/pacman -S --needed --noconfirm $_want >>"$LOG" 2>&1; then
            log "extras instalados:$_want"
            extras_note=" + programas (WM/clientes)"
        else
            log "extras FALHARAM:$_want"
            extras_note=" (extras falharam; as libs criticas continuam ok)"
        fi
    elif [ -n "$_skip" ]; then
        extras_note=" (indisponiveis neste repo:$_skip)"
    fi
fi

if [ "$rc" = "0" ]; then
    log "ok: libs de cliente X11 presentes$extras_note"
    echo "ok: libs de cliente X11 ja presentes$extras_note"
    exit 0
fi

# Falha: mensagem util no terminal, com o caminho do log. Nada de sumir.
log "FALHOU: nao foi possivel instalar as libs de cliente X11"
printf 'X11: FALHOU ao instalar as libs de cliente (%s).\n' "$MISSING" >&2
printf 'X11: rode no container -> pacman -S --needed --noconfirm %s\n' "$LIB_PKGS" >&2
printf 'X11: detalhes em %s\n' "$LOG" >&2
echo "FALHOU: libs de cliente X11"
exit 1
