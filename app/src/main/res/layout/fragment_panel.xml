<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Linha compacta de gerenciamento: quatro abas + ação separada Terminal. -->
    <LinearLayout
        android:id="@+id/panelNavRow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/tux_surface_alt"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/panelTabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/tux_violet"
            app:tabIndicatorHeight="2dp"
            app:tabMode="fixed"
            app:tabRippleColor="@color/tux_cyan_container"
            app:tabSelectedTextColor="@color/tux_violet_light"
            app:tabTextAppearance="@style/TextAppearance.TuxBox.Tab"
            app:tabTextColor="@color/tux_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPanelTerminal"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/panel_open_terminal"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="0dp"
            android:paddingEnd="10dp"
            android:paddingBottom="0dp"
            android:text="@string/tab_terminal"
            android:textAllCaps="false"
            android:textColor="@color/tux_violet_light"
            android:textSize="12sp"
            app:backgroundTint="@color/tux_violet_container"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_terminal"
            app:iconPadding="4dp"
            app:iconSize="18dp"
            app:iconTint="@color/tux_cyan" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tux_stroke" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/panelContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
