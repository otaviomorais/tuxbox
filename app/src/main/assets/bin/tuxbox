#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 LongQT-sea <long025733@gmail.com>
#
# tuxbox - chroot on steroids
#
# A ~500-line POSIX shell script that implements minimal Linux
# container using namespaces, bind mounts, and pivot_root.
#
# No daemons. No D-Bus. No dependencies beyond a POSIX shell,
# a few coreutils or busybox, and a kernel >= 4.19.
#
# Why?
#
# Because containers are just namespaces + bind mounts + pivot_root.
# That's it. Everything else is optional. This script exists to prove that point.
#
# The goal is do the hard part once so you never have to again.
# We set up the namespace plumbing so you get a clean Linux environment,
# then get out of the way and let you work natively inside it.
#
# Android support is a first-class concern, not an afterthought.
# Smartphones are the computers people actually have. Over 6 billion
# of them exist. A Snapdragon 865 from 2020 matches an old desktop i5
# while sipping single-digit watts. These are real computers
# more powerful than the servers that ran the early internet.
#
# A phone with a cracked screen and a dead battery is still a
# perfectly good 8-core Linux server with no moving parts that
# fits in your pocket. Billions of them get landfilled every year.
# The hardware is fine; the software ecosystem threw it away.
# Running a real Linux userspace on these devices isn't a hack,
# it's the sane thing to do.
#
# If your rooted phone has a kernel that supports namespaces (4.19+),
# this script will run a full Linux userspace on it -- Debian, Arch,
# Alpine, whatever you need, the companion getroot tool has you covered.
#
# This means: toybox pivot_root, busybox mount fallbacks,
# iproute2 from /system/bin/ip, routing policy for VPN/WiFi/LTE,
# and working around every quirk Android throws at you.
# It's ugly, but it works, and that matters more.
#
# Tested on Android (toybox, busybox, Termux), Alpine, Debian, and bare
# busybox containers. If you have unshare, mount, and pivot_root,
# this script will work.
#
# Design:
#
#   Phase 1 (runs as root on the host)
#     - Parse arguments
#     - Set up bridge networking and NAT (if --net)
#     - Create a network namespace and veth pair
#     - Detect available namespace support
#     - exec into Phase 2 via unshare(1)
#
#   Phase 2 (runs inside the new namespace)
#     - Bind mount the rootfs
#     - Mount /proc, /sys, /dev, /tmp, /run
#     - Create minimal device nodes
#     - Mask sensitive paths (/proc/keys, /sys/firmware, etc.)
#     - pivot_root into the new rootfs
#     - exec the requested command (or a login shell)
#
# The mount namespace is the key insight: by doing all our bind
# mounts inside a new mount namespace, cleanup is automatic.
# When the process exits, the namespace is destroyed, and every
# mount we made disappears with it. No cleanup code needed.
# This is the right way to do it.
#
# Usage:
#   tuxbox <rootfs>                    # shell into a container
#   tuxbox --net <rootfs>              # with network namespace
#   tuxbox --net --port-range 80:8080 <rootfs>  # with port forwarding
#   tuxbox --net --route-via tun0 <rootfs>  # pin container to VPN
#   tuxbox <rootfs> /bin/bash -l       # specific command
#
# To get internet inside the container with --net, the host needs
# ip_forward=1 and iptables MASQUERADE, which this script sets up.
# On Android, source-based policy routing is configured automatically
# to handle VPN/WiFi/LTE priority.
#
# If you boot systemd init with 'exec init', the best way to
# log back in is ssh. But you can also do this from another terminal:
#
#   sudo nsenter -t $(sudo pgrep -nfx init) -ea chroot / su -

VERSION="1.0.1"
# v3.11 — os logs de diagnóstico NÃO podem ficar dentro de /data/local/tuxbox:
# essa pasta é a BASE dos containers e o app lista tudo que está nela, então
# ptyd.log/boot-early.log apareciam como "containers" e quebravam a lista
# (v3.9e/f). Agora vivem em /data/local/tuxbox-logs, fora da base.
_TB_LOGS=/data/local/tuxbox-logs
mkdir -p "$_TB_LOGS" 2>/dev/null || true
# limpeza dos logs que a v3.9e/f deixou na base (só os nossos, uma vez)
rm -f /data/local/tuxbox/ptyd.log /data/local/tuxbox/boot-early.log 2>/dev/null || true
# rastreio na 1ª linha util, ANTES do set -e: se o script morrer aqui, o motivo
# fica no arquivo (uid/kernel/shell + args crus), mesmo sem rootfs valida.
{ echo "[tuxbox-early $(date +%H:%M:%S) pid=$$] args: $*"; echo "uid=$(id -u 2>/dev/null) kernel=$(uname -r 2>/dev/null) sh=$0"; } >> "$_TB_LOGS/boot-early.log" 2>/dev/null || true
{ echo "[tuxbox-early pid=$$] args: $*"; } >&2 2>/dev/null || true
set -e

# Android routing priority offsets
# Default: VPN > WiFi > Mobile data
# Lower number = higher priority (1-3000)
VPN_PRIO=100
WIFI_PRIO=200
MOBILE_PRIO=300

NET_PREFIX="10.11.0"
SUBNET="/24"
BRIDGE_SUBNET="${NET_PREFIX}.0${SUBNET}"
BRIDGE_IP="${NET_PREFIX}.1"

NET6_PREFIX="fd11::"
SUBNET6="/64"
BRIDGE_SUBNET6="${NET6_PREFIX}${SUBNET6}"
BRIDGE_IP6="${NET6_PREFIX}1"

BRIDGE="tuxbox_br1"
PORT_RANGE=""
WAN_IF=""  # Auto-detect if empty, used for port forwarding rules

# These are Qualcomm Snapdragon cellular interface; I do not have MediaTek-based phone
MOBILE_DATA_IFACE="rmnet_data1 rmnet_data2 rmnet_data3 rmnet_data4"

RT_DIR="/run/tuxbox"
NETNS_DIR="/run/netns"
RED=$(printf '\033[31m')
GREEN=$(printf '\033[32m')
NC=$(printf '\033[0m')

die() { printf '%sError: %s%s\n' "$RED" "$*" "$NC" >&2; exit 1; }
info() { printf '%s==> %s%s\n' "$GREEN" "$*" "$NC" >&2; }
warn() { printf '%sWarning: %s%s\n' "$RED" "$*" "$NC" >&2; }

# Diagnóstico de boot: vai pro log do container (tuxbox-boot.log), NUNCA pro
# pty/terminal — o prompt entra limpo. Apenas erros reais ficam no stderr.
bootinfo() {
    mkdir -p "${TB_BOOT_LOG%/*}" 2>/dev/null || true
    echo "[tuxbox] $(date +%H:%M:%S) $*" >> "${TB_BOOT_LOG:-/dev/null}" 2>/dev/null || true
}

# Android quirks
if [ -n "${ANDROID_ROOT:-}" ] && [ -n "${ANDROID_DATA:-}" ]; then
    ANDROID=1
    RT_DIR="/mnt/tuxbox"
    NETNS_DIR="/mnt/run"
    _PATH="/usr/sbin:/usr/bin:/sbin:/bin:/system/bin"

    # Yes toybox does have pivot_root
    pivot_root() { toybox pivot_root "$@"; }

    # Android does have iproute2 ip command
    ip() { /system/bin/ip "$@"; }

    # toybox mount is missing required features
    if command -v busybox >/dev/null 2>&1; then
        mount() { busybox mount "$@"; }
    elif [ "$(command -v mount)" = "/system/bin/mount" ]; then
        die "toybox mount is not supported"
    fi
fi

if command -v unshare >/dev/null; then
    unshare() { command unshare "$@"; }
elif command -v busybox && busybox unshare --help >/dev/null 2>&1; then
    unshare() { busybox unshare "$@"; }
else
    die "Need unshare command"
fi

# === Phase 2 ===
if [ "${PHASE2:-}" = "1" ]; then
    # Run inside a Linux namespace (at least a mount namespace)
    ROOTFS="$1"
    shift
    TB_BOOT_LOG="$ROOTFS/var/log/tuxbox-boot.log"

    echo -1000 > /proc/self/oom_score_adj 2>/dev/null || true

    # v3.10 — REVERSAO do v3.9d: o `trap ... ERR` é NAO-PORTÁVEL. O
    # /system/bin/sh do Android (mksh) nao implementa a condicao ERR, entao o
    # trap devolve erro e — por causa do `set -e` — MATAVA O SCRIPT EM SILENCIO
    # (exit=1, zero log, terminal vazio). Era exatamente a regressao
    # v3.9d->v3.9f. Agora o trap e guardado: onde o shell tem ERR ele diagnostica,
    # onde nao tem (mksh) e apenas ignorado. O restante (guardas || warn/|| true
    # do pre-pivot, protecao OOM) do v3.9d foi MANTIDO — sao defensivos.
    # v3.11 — `set -E` REMOVIDO (CAUSA RAIZ do exit=1). No mksh do Android
    # (e no mksh R59 reproduzido no host) `-E` é opção DESCONHECIDA: o shell
    # ABORTA imediatamente com rc=1 e ignora o `|| true` — nem executa o resto
    # da linha. Reproduzido: mksh -c 'set -E 2>/dev/null || true; echo depois'
    # imprime NADA e sai 1. Era o que matava o boot em v3.9c/d/e/f (a fase 1
    # morria aqui, antes do primeiro bootinfo → exit=1, terminal vazio).
    # O `trap ... ERR` abaixo NÃO tem esse problema (testado: funciona e a
    # versão guardada é inofensiva), então continua como diagnóstico.
    trap 'echo "[tuxbox] P2-DIE $(date +%H:%M:%S) LINHA=$LINENO rc=$?" >> "${TB_BOOT_LOG:-/dev/null}" 2>/dev/null || true' ERR 2>/dev/null || true

    if [ $# -eq 0 ]; then
        if [ -x "$ROOTFS/bin/bash" ]; then
            set -- /bin/bash -il
        else
            set -- /bin/sh -il
        fi
    fi

    if [ "${UTS_NS:-}" = "1" ]; then
        echo "$HOSTNAME" > /proc/sys/kernel/hostname
        echo "$HOSTNAME" > "$ROOTFS/etc/hostname"
        grep -q "127.0.1.1.*$HOSTNAME" "$ROOTFS/etc/hosts" 2>/dev/null || \
            echo "127.0.1.1	$HOSTNAME" >> "$ROOTFS/etc/hosts"
    fi

    mount -o bind,private "$ROOTFS" "$ROOTFS"

    # Android quirks
    # /mnt on Android is a tmpfs mounted with restrictive flags (nosuid/nodev/noexec).
    # Remount the rootfs bind mount explicitly with exec/suid/dev/rw, otherwise
    # exec of /bin/sh inside the container fails with EACCES ("can't execute").
    mount -o remount,exec,suid,dev,rw "$ROOTFS"

    # This makes the `ip rule` command inside the container show human-readable rule name when using host network
    # https://android.googlesource.com/platform/system/netd/+/refs/heads/main/server/RouteController.h#105
    if [ "${USE_NETNS:-}" != "1" ] && [ "${ANDROID:-}" = "1" ]; then
        mkdir -p "$ROOTFS/etc/iproute2"
        touch "$ROOTFS/etc/iproute2/rt_tables"
        mount -o bind /data/misc/net/rt_tables "$ROOTFS/etc/iproute2/rt_tables" 2>/dev/null \
            || warn "/data/misc/net/rt_tables missing on host, skipping iproute2 tables"
    fi

    # Expose Android user 0 internal storage to the container
    if [ "${ANDROID:-}" = "1" ] && [ -d /data/media/0 ]; then
        mkdir -p "$ROOTFS/mnt/storage"
        mount -o bind /data/media/0 "$ROOTFS/mnt/storage" 2>/dev/null \
            || warn "could not bind /data/media/0 into container"
    fi

    # Optional: external microSD volume(s) too, mounted under /mnt/storage/
    for sd in /storage/*; do
        case "$(basename "$sd")" in
            emulated|self) continue ;;
        esac
        [ -d "$sd" ] || continue
        mkdir -p "$ROOTFS/mnt/storage/$(basename "$sd")"
        mount -o bind "$sd" "$ROOTFS/mnt/storage/$(basename "$sd")" 2>/dev/null || true
    done

    mount -t proc -o nosuid,nodev,noexec proc "$ROOTFS/proc"
    mount -t sysfs -o ro,nosuid,nodev,noexec sysfs "$ROOTFS/sys"

    # cgroup2 (or v1 fallback) is optional for a plain shell; systemd needs it
    # but the container must still start when the kernel lacks it.
    if ! mount -t cgroup2 -o nosuid,noexec,nodev cgroup "$ROOTFS/sys/fs/cgroup" 2>/dev/null; then
        mount -t cgroup -o nosuid,noexec,nodev cgroup "$ROOTFS/sys/fs/cgroup" 2>/dev/null \
            || warn "cgroup filesystem unavailable, continuing without it"
    fi
    mount -t tmpfs -o nosuid,nodev,noatime tmpfs "$ROOTFS/tmp"
    mount -t tmpfs -o rw,nosuid,nodev,mode=755 tmpfs "$ROOTFS/run"
    mount -t tmpfs -o noexec,mode=755,strictatime tmpfs "$ROOTFS/dev"

    # Minimal /dev setup; a classic bind mount of /dev is usually overkill
    mkdir -p "$ROOTFS/dev/pts" "$ROOTFS/dev/shm" "$ROOTFS/dev/net" "$ROOTFS/dev/mqueue"
    mount -t tmpfs -o nosuid,noexec,nodev,mode=1777,size=524288k shm "$ROOTFS/dev/shm"

    # POSIX message queues (mqueue fs) is not compiled into most Android kernels
    # (ENODEV "No such device"). Keep the mount point as a plain directory then.
    if ! mount -t mqueue -o nosuid,nodev,noexec mqueue "$ROOTFS/dev/mqueue" 2>/dev/null; then
        bootinfo "mqueue not supported by kernel, /dev/mqueue stays an empty dir"
    fi

    mknod -m 666 "$ROOTFS/dev/null" c 1 3
    mknod -m 666 "$ROOTFS/dev/zero" c 1 5
    mknod -m 666 "$ROOTFS/dev/full" c 1 7
    mknod -m 666 "$ROOTFS/dev/tty" c 5 0
    mknod -m 666 "$ROOTFS/dev/fuse" c 10 229
    mknod -m 666 "$ROOTFS/dev/random" c 1 8
    mknod -m 666 "$ROOTFS/dev/urandom" c 1 9
    mknod -m 0620 "$ROOTFS/dev/console" c 5 0
    mknod -m 666 "$ROOTFS/dev/net/tun" c 10 200

    # GPU passthrough: when the host kernel exposes DRM nodes (/dev/dri),
    # bind them so Mesa's native drivers (freedreno/Adreno, panfrost/Mali)
    # work inside the container. Nothing here involves virgl/GL passthrough;
    # without /dev/dri, Mesa just falls back to llvmpipe (software GL).
    GPU_BOUND=0
    HAS_KGSL_MESA=0
    if [ -d /dev/dri ]; then
        mkdir -p "$ROOTFS/dev/dri"
        if mount -o bind /dev/dri "$ROOTFS/dev/dri" 2>&1; then
            GPU_BOUND=1
        else
            echo "[tuxbox] aviso: bind de /dev/dri falhou (SELinux/mount negado?)" >&2
        fi
        for gpu_dev in kgsl-3d0 kgsl3d0 mali mali0 gpu; do
            if [ -e "/dev/$gpu_dev" ]; then
                mount -o bind "/dev/$gpu_dev" "$ROOTFS/dev/$gpu_dev" 2>/dev/null || true
            fi
        done
    fi
    # Adreno via kgsl (ROM híbrida/downstream ou kernel sem DRM): o node é criado
    # DIRETO no tmpfs do container (major:minor lido do sysfs; fallback 511:0 do
    # Adreno) — não depende do host ter criado /dev/kgsl-3d0 nem do bind. Se o
    # host tiver o node, usa-o como fallback.
    if [ -r /sys/class/kgsl/kgsl-3d0/dev ]; then
        _kgsl_dev=$(cat /sys/class/kgsl/kgsl-3d0/dev 2>/dev/null || true)
        case "$_kgsl_dev" in
            *:*)
                if mknod -m 666 "$ROOTFS/dev/kgsl-3d0" c "${_kgsl_dev%%:*}" "${_kgsl_dev##*:}" 2>/dev/null; then
                    GPU_BOUND=1
                    bootinfo "kgsl: node criado no container (${_kgsl_dev%%:*}:${_kgsl_dev##*:})"
                fi
                ;;
        esac
    elif [ -r /sys/class/kgsl/kgsl-3d0/gpu_model ]; then
        if mknod -m 666 "$ROOTFS/dev/kgsl-3d0" c 511 0 2>/dev/null; then
            GPU_BOUND=1
            bootinfo "kgsl: node criado no container (fallback 511:0)"
        fi
    fi
    if [ ! -e "$ROOTFS/dev/kgsl-3d0" ] && [ -e /dev/kgsl-3d0 ]; then
        mount -o bind /dev/kgsl-3d0 "$ROOTFS/dev/kgsl-3d0" 2>/dev/null || true
        GPU_BOUND=1
    fi
    # Alocador de dma-buf p/ o Turnip (kgsl): o zink precisa de
    # VK_KHR_external_memory_fd pra criar os swapchains do X11 (DRI3) e sem
    # /dev/ion (ou /dev/dma_heap/system) ele falha com "could not create
    # swapchain" + VK_ERROR_OUT_OF_DEVICE_MEMORY. Cria o node que o kernel
    # expõe (major 10/misc), com fallback 10:62 (downstream SM8250).
    if [ -r /sys/class/misc/ion/dev ]; then
        _ion_dev=$(cat /sys/class/misc/ion/dev 2>/dev/null || true)
        case "$_ion_dev" in
            *:*)
                if mknod -m 666 "$ROOTFS/dev/ion" c "${_ion_dev%%:*}" "${_ion_dev##*:}" 2>/dev/null; then
                    bootinfo "kgsl: /dev/ion criado (${_ion_dev%%:*}:${_ion_dev##*:})"
                fi
                ;;
        esac
    fi
    if [ ! -e "$ROOTFS/dev/ion" ] && [ -e /dev/ion ]; then
        mount -o bind /dev/ion "$ROOTFS/dev/ion" 2>/dev/null || true
    fi
    if [ ! -e "$ROOTFS/dev/ion" ]; then
        if mknod -m 666 "$ROOTFS/dev/ion" c 10 62 2>/dev/null; then
            bootinfo "kgsl: /dev/ion criado (fallback 10:62)"
        fi
    fi
    if [ -r /sys/class/misc/dma_heap-system/dev ]; then
        _dma_dev=$(cat /sys/class/misc/dma_heap-system/dev 2>/dev/null || true)
        case "$_dma_dev" in
            *:*)
                mkdir -p "$ROOTFS/dev/dma_heap"
                if mknod -m 666 "$ROOTFS/dev/dma_heap/system" c "${_dma_dev%%:*}" "${_dma_dev##*:}" 2>/dev/null; then
                    bootinfo "kgsl: /dev/dma_heap/system criado (${_dma_dev%%:*}:${_dma_dev##*:})"
                fi
                ;;
        esac
    fi
    if find "$ROOTFS/usr/lib" -maxdepth 3 -name '*kgsl*.so*' -print -quit 2>/dev/null | grep -q .; then
        HAS_KGSL_MESA=1
    fi
    ln -sf pts/ptmx "$ROOTFS/dev/ptmx" 2>/dev/null || true
    ln -sf /proc/self/fd "$ROOTFS/dev/fd" 2>/dev/null || true
    ln -sf /proc/self/fd/0 "$ROOTFS/dev/stdin" 2>/dev/null || true
    ln -sf /proc/self/fd/1 "$ROOTFS/dev/stdout" 2>/dev/null || true
    ln -sf /proc/self/fd/2 "$ROOTFS/dev/stderr" 2>/dev/null || true

#    mount -t devpts -o nosuid,noexec,newinstance,ptmxmode=0666,mode=620,gid=5 devpts "$ROOTFS/dev/pts"
    mount -o bind /dev/pts "$ROOTFS/dev/pts" 2>/dev/null \
        || warn "devpts bind falhou (SELinux enforcing?) — /dev/pts sem mux; pts via ptmx/symlink"
    mount -o remount,ptmxmode=0666,mode=620 "$ROOTFS/dev/pts" 2>/dev/null \
        || warn "devpts remount falhou — ptmxmode pode ficar errado"

    # Try hook pty -> /dev/console for console login, but that didn't work out, by masking console-getty
    # at least we still have a console log with job control (Ctrl-C to shutdown systemd)
    if [ -t 0 ]; then
        mount -o bind "$(tty)" "$ROOTFS/dev/console" 2>/dev/null || true
    fi

    if [ -f "$ROOTFS/usr/lib/systemd/systemd" ]; then
        ln -sf /dev/null "$ROOTFS/etc/systemd/system/console-getty.service"
        ln -sf /dev/null "$ROOTFS/etc/systemd/system/systemd-firstboot.service"
        ln -sf /dev/null "$ROOTFS/etc/systemd/system/systemd-networkd-wait-online.service"
    fi

    mask_path() {
        path="$1"
        target="${ROOTFS}${path}"
        if [ -d "$target" ]; then
            mount -t tmpfs -o ro,nosuid,nodev,noexec,size=0 tmpfs "$target" 2>/dev/null || true
        elif [ -f "$target" ]; then
            mount -o bind /dev/null "$target" 2>/dev/null || true
        fi
    }

    readonly_path() {
        target="${ROOTFS}${1}"
        if [ -e "$target" ]; then
            mount -o bind,ro "$target" "$target" 2>/dev/null || true
        fi
    }

    # Protect sensitive paths
    mask_path "/proc/asound"
    mask_path "/proc/sched_debug"
    mask_path "/proc/scsi"
    mask_path "/proc/keys"
    mask_path "/proc/timer_list"
    mask_path "/proc/kmsg"
    mask_path "/sys/firmware"
    mask_path "/sys/power"
    # Only hide /sys/class/drm when there is no GPU to show; when /dev/dri was
    # bound above, libdrm/Mesa use that class to enumerate the device.
    if [ "${GPU_BOUND:-0}" != "1" ]; then
        mask_path "/sys/class/drm"
    fi
    readonly_path "/proc/bus"
    readonly_path "/proc/fs"
    readonly_path "/proc/irq"
    readonly_path "/proc/sysrq-trigger"

    # Android quirks
    if [ "${ANDROID:-}" = "1" ]; then
        echo "0 2147483647" > "$ROOTFS/proc/sys/net/ipv4/ping_group_range" 2>/dev/null || true
        export PATH="$_PATH" && unset LD_PRELOAD

        # Android DNS: override the container resolv.conf with the device's real
        # resolvers. Ubuntu images ship a stub pointing at 127.0.0.53
        # (systemd-resolved), which does not exist inside the container, so DNS
        # fails with "Temporary failure resolving". Sources: netd's resolv.conf
        # first, then getprop, then a public fallback.
        dns=""
        if [ -r /system/etc/resolv.conf ]; then
            dns=$(sed -n 's/^[[:space:]]*nameserver[[:space:]]\+//p' /system/etc/resolv.conf 2>/dev/null || true)
        fi
        if [ -z "$dns" ]; then
            for p in net.dns1 net.dns2 dhcp.wlan0.dns1 dhcp.eth0.dns1; do
                v=$(getprop "$p" 2>/dev/null || true)
                if [ -n "$v" ]; then
                    dns="${dns:+$dns }$v"
                fi
            done
        fi
        if [ -z "$dns" ]; then
            dns="1.1.1.1 8.8.8.8"
        fi
        rm -f "$ROOTFS/etc/resolv.conf"
        {
            echo "# generated by tuxbox"
            for dns_server in $dns; do
                echo "nameserver $dns_server"
            done
        } > "$ROOTFS/etc/resolv.conf" 2>/dev/null || warn "could not write $ROOTFS/etc/resolv.conf"

        # Normalize perms that a sloppy extraction may have left loose:
        # sudo.conf must not be world-writable, and apt wants the lists dir
        # owned by _apt (else the "unsandboxed as root" warning on Ubuntu).
        if [ -f "$ROOTFS/etc/sudo.conf" ]; then
            chmod 0644 "$ROOTFS/etc/sudo.conf" 2>/dev/null || true
        fi
        if grep -qs '^_apt:' "$ROOTFS/etc/passwd"; then
            chown -R _apt:root "$ROOTFS/var/lib/apt/lists" 2>/dev/null || true
        fi
    fi

    # Ubuntu 25 Rust quirk
    export PATH="$PATH:/lib/cargo/bin/coreutils"

    # === Interface gráfica via termux-x11 (--gui) ===
    # Método oficial do termux-x11 pra chroot: o servidor X roda via
    # app_process + CmdEntryPoint com TMPDIR num scratch dedicado dentro do
    # rootfs, $ROOTFS/var/lib/tuxbox-x11 (disk-backed, COMPARTILHADO entre
    # abas desse rootfs; dentro do container e' /var/lib/tuxbox-x11). Cada aba
    # expoe o socket via symlink /tmp/.X11-unix/X0 — sem bind mounts nem
    # LD_PRELOAD. XKB_CONFIG_ROOT aponta pro xkb do container pra evitar erros
    # de xkbcomp no servidor.
    X11_ENV=""
    if [ "${GUI:-0}" = "1" ]; then
        # v3.26 — xkb-data é requisito do termux-x11. O botão Instalar binários
        # já o instala em todos os containers; esta segunda chamada cobre o
        # caso de uma imagem nova/importada ser aberta diretamente com --gui.
        _bin_dir="$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd || true)"
        if [ -n "$_bin_dir" ] && [ -x "$_bin_dir/ensure-xkb" ]; then
            "$_bin_dir/ensure-xkb" "$ROOTFS" || \
                warn "X11: nao foi possivel instalar xkb-data automaticamente (log: $ROOTFS/var/log/tuxbox-xkb.log)"
        fi
        _tx11_ok=0
        _tx11_apk=$(/system/bin/pm path com.termux.x11 2>/dev/null | cut -d: -f2 | head -1 || true)
        if [ -n "$_tx11_apk" ]; then
            # app_process servindo socket pra chroot costuma ser barrado pelo
            # SELinux enforcing; tenta permissive (best-effort).
            if [ -e /sys/fs/selinux/enforce ]; then
                setenforce 0 2>/dev/null || true
            fi
            bootinfo "X11: bloco --gui iniciado (apk=$_tx11_apk)"
            # v3.9 — UM unico servidor X compartilhado entre TODAS as abas do
            # mesmo rootfs (multi-container). O scratch do servidor vive num
            # diretorio FIXO dentro do rootfs ($ROOTFS/var/lib/tuxbox-x11, que
            # dentro do container e' /var/lib/tuxbox-x11): disk-backed, entao
            # TODAS as abas desse rootfs veem o MESMO socket. Cada aba expoe via
            # SYMLINK /tmp/.X11-unix/X0 -> /var/lib/tuxbox-x11/.X11-unix/X0.
            # (Bind mounts foram testados e FALHAM neste SELinux — o v3.8 provou
            # com "AVISO bind FALHOU"; symlink era o mecanismo do v3.4 que
            # sempre funcionou.) Abrir outra aba nunca mata o servidor — so
            # "conecta" nele.
            _SR="var/lib/tuxbox-x11"
            _SRV="$ROOTFS/$_SR"
            # v3.11 — CORREÇÃO do erro "can't create /data/local/tuxbox/x11/lock:
            # No such file or directory": o lock/xkb/log do servidor ainda
            # apontavam para /data/local/tuxbox/x11 (scratch da v3.6/v3.7), que
            # NAO existe mais desde a v3.9 — o `9>lock` falhava com ENOENT e o
            # servidor nunca subia. Agora o estado persistente vive em
            # $ROOTFS/var/lib/tuxbox-x11-state: disk-backed (compartilhado por
            # TODAS as abas do mesmo rootfs, como o lock precisa) e FORA do
            # TMPDIR do servidor ($_SRV) — que o app_process APAGA na saida, o
            # que comecaria a levar lock/xkb junto.
            _ST="var/lib/tuxbox-x11-state"
            _STD="$ROOTFS/$_ST"
            _XS_RUN="$_SRV/run"
            _XS_LOCK="$_STD/lock"
            _XS_XKB="$_STD/xkb"
            _XS_SLOG="$_STD/termux-x11.log"
            # v3.16 — sem "$ROOTFS/var/lock" aqui: em imagem Debian/usrmerge ele
            # e' symlink para /run/lock e o `mkdir -p` nele falha (EEXIST/ENOENT)
            # — matava o boot. O lock do watchdog agora vive em $_STD. O `|| true`
            # garante que nenhuma falha de mkdir nao derrube o container.
            mkdir -p "$_SRV/.X11-unix" "$_XS_RUN" "$_STD" \
                "$ROOTFS/tmp/.X11-unix" \
                "$ROOTFS/run/user/0" "$ROOTFS/var/log" "$ROOTFS/var/lib" 2>/dev/null || true
            chmod 700 "$_XS_RUN" "$ROOTFS/run/user/0" 2>/dev/null || true
            # Listener real em /proc/net/unix (mesmo criterio do watchdog).
            _x11_listen() {
                [ -S "$1" ] || return 1
                awk -v p="$1" 'NR>1 && $NF==p && $6=="01" {f=1} END {exit !f}' \
                    /proc/net/unix 2>/dev/null
            }
            # v3.7: launch e espera como helpers. Subida FRIa do servidor
            # (1a vez / apos reboot) pode levar ~20-40s (ART/dex2oat lento com
            # KernelSU/susfs): espera 40s e, se falhar, tenta de novo — nunca
            # "nao subiu" por pressa de timeout.
            _x11_trylaunch() {
                ( flock -n 9 2>/dev/null || true
                  if ! _x11_listen "$_SRV/xvfb.sock" && \
                     ! _x11_listen "$_SRV/.X11-unix/X0"; then
                      pkill -f 'com.termux.x11.CmdEntryPoint' 2>/dev/null || true
                      # v3.16 — CORRACAO DE CORRIDA: o CmdEntryPoint APAGA o
                      # TMPDIR quando sai. Sem esperar, o mkdir abaixo roda
                      # enquanto o servidor morto ainda esta limpando e o novo
                      # servidor cai em mkdir ENOENT / "Cannot establish any
                      # listening sockets" — era o que travava imagem NOVA.
                      sleep 1
                      mkdir -p "$_SRV/.X11-unix" "$_XS_RUN" 2>/dev/null || true
                      rm -f "$_SRV/xvfb.sock" "$_SRV/.X11-unix/X0" \
                          "$_SRV/.X11-unix/.X0-lock" 2>/dev/null || true
                      # v3.16 — xkb: imagem nova (ex.: Debian minima) pode nao
                      # ter /usr/share/X11/xkb, e o X morre com "Failed to
                      # activate virtual core keyboard". Ordem: (1) o xkb deste
                      # rootfs; (2) o path em cache de um container que tinha
                      # (gravado em /data/local/tuxbox-x11/xkb-path, fora da base
                      # de containers); (3) o path do proprio rootfs, com aviso
                      # de como instalar.
                      _xkb=""
                      if [ -d "$ROOTFS/usr/share/X11/xkb" ]; then
                          _xkb="$ROOTFS/usr/share/X11/xkb"
                          mkdir -p /data/local/tuxbox-x11 2>/dev/null || true
                          echo "$_xkb" > /data/local/tuxbox-x11/xkb-path 2>/dev/null || true
                      elif [ -r /data/local/tuxbox-x11/xkb-path ]; then
                          _xkb="$(cat /data/local/tuxbox-x11/xkb-path 2>/dev/null)"
                          [ -d "$_xkb" ] || _xkb=""
                      fi
                      if [ -z "$_xkb" ]; then
                          _xkb="$ROOTFS/usr/share/X11/xkb"
                          bootinfo "X11: AVISO sem xkeyboard-config neste container — o X pode nao subir (apt install -y xkb-data)"
                      fi
                      echo "$_xkb" > "$_XS_XKB" 2>/dev/null || true
                      TMPDIR="$_SRV" XKB_CONFIG_ROOT="$_xkb" \
                      XDG_RUNTIME_DIR="$_XS_RUN" CLASSPATH="$_tx11_apk" \
                      setsid /system/bin/app_process / --nice-name=termux-x11 \
                          com.termux.x11.CmdEntryPoint :0 \
                          >> "$_XS_SLOG" 2>&1 9>&- &
                  fi
                # v3.11 — `2>/dev/null` ANTES do `9>`: se a criacao do lock
                # falhar, a mensagem de erro do mksh vai para /dev/null em vez de
                # sujar o terminal (a ordem original imprimia no pty).
                ) 2>/dev/null 9>"$_XS_LOCK" || true
            }
            _x11_wait() { # espera listener; arg = iteracoes de 0.4s
                _i=0
                while [ "$_i" -lt "$1" ]; do
                    if _x11_listen "$_SRV/xvfb.sock" || \
                       _x11_listen "$_SRV/.X11-unix/X0"; then
                        return 0
                    fi
                    _i=$((_i + 1))
                    sleep 0.4
                done
                return 1
            }
            # v3.41 — display :0 e' global, mas o mesmo servidor Termux:X11
            # pode servir varios containers. Se outro rootfs ja possui o
            # listener, reutilizamos seu socket por um bind mount em vez de
            # bloquear a segunda GUI. O fallback takeover permanece para o
            # caso o bind seja proibido pelo SELinux.
            _x11_takeover=0
            [ -f "$ROOTFS/root/.x11_takeover" ] && _x11_takeover=1
            _x11_owner=""
            _x11_shared=0
            _x11_shared_sock=""
            if [ "$_x11_takeover" != "1" ]; then
                _x11_owner="$(awk 'NR>1 && $6=="01" {print $NF}' /proc/net/unix 2>/dev/null \
                    | grep -E '/\.X11-unix/X[0-9]+$|/xvfb\.sock$' \
                    | grep -v "^$_SRV/" | head -n 1)"
            fi
            if [ -n "$_x11_owner" ]; then
                _x11_owner_dir=""
                case "$_x11_owner" in
                    */.X11-unix/X0)
                        _x11_owner_dir="${_x11_owner%/.X11-unix/X0}"
                        _x11_shared_sock=".X11-unix/X0"
                        ;;
                    */xvfb.sock)
                        _x11_owner_dir="${_x11_owner%/xvfb.sock}"
                        _x11_shared_sock="xvfb.sock"
                        ;;
                esac
                _x11_shared_mount="$ROOTFS/var/lib/tuxbox-x11-shared"
                mkdir -p "$_x11_shared_mount" "$ROOTFS/tmp/.X11-unix" 2>/dev/null || true
                if [ -n "$_x11_owner_dir" ] && [ -d "$_x11_owner_dir" ] && \
                   mount -o bind "$_x11_owner_dir" "$_x11_shared_mount" 2>/dev/null; then
                    _x11_shared=1
                    bootinfo "X11: display :0 compartilhado com outro container ($_x11_owner)"
                else
                    bootinfo "X11: display :0 pertence a outro container ($_x11_owner), mas o bind do socket falhou — este container abriu SEM X11"
                    warn "X11: o display :0 ja esta em uso; feche a outra GUI ou crie /root/.x11_takeover para assumir"
                fi
            fi
            if [ "$_x11_shared" != "1" ] && [ -z "$_x11_owner" -o "$_x11_takeover" = "1" ]; then
                _x11_trylaunch
                if _x11_wait 100; then
                    bootinfo "X11: servidor visto no wait (compartilhado ok)"
                else
                    bootinfo "X11: wait1 (40s) esgotou sem listener compartilhado; 2a tentativa"
                    _x11_trylaunch
                    _x11_wait 60 || true
                fi
            fi
            # Publica o socket no /tmp do container: SYMLINK (bind mounts falham no
            # SELinux aqui — provado no v3.8). /tmp e' tmpfs POR ABA; o alvo
            # /var/lib/tuxbox-x11/... e' disk-backed e visivel em TODAS as abas
            # do mesmo rootfs. NOTA (v3.9b): pre-pivot o alvo absoluto NAO
            # resolve no host — /var/lib/... so' existe DENTRO do container —
            # entao a validacao usa o par (socket real em _SRV + symlink
            # presente em $ROOTFS/tmp), nunca resolve o alvo aqui.
            _SOCK=
            if [ "$_x11_shared" = "1" ]; then
                _SOCK="var/lib/tuxbox-x11-shared/$_x11_shared_sock"
            elif [ -S "$_SRV/.X11-unix/X0" ]; then
                _SOCK="$_SR/.X11-unix/X0"
            elif [ -S "$_SRV/xvfb.sock" ]; then
                _SOCK="$_SR/xvfb.sock"
            fi
            _X11_LINK=0
            if [ -n "$_SOCK" ]; then
                ln -sfn "/$_SOCK" "$ROOTFS/tmp/.X11-unix/X0" 2>/dev/null || true
                [ -L "$ROOTFS/tmp/.X11-unix/X0" ] && _X11_LINK=1
            fi
            if [ "$_X11_LINK" = "1" ]; then
                bootinfo "X11: socket compartilhado exposto: /tmp/.X11-unix/X0 -> /$_SOCK"
            else
                bootinfo "X11: AVISO symlink nao criado — /tmp do container sem X0 (_SOCK=$_SOCK)"
            fi
            # Watchdog v3.8 (script persistente no rootfs): monitora o socket
            # COMPARTILHADO e ressuscita UM unico servidor (restore serializado
            # por flock + re-check). Singleton por lockdir+pid em var/lock.
            _x11_wd_pid=
            if [ "${_x11_shared:-0}" != "1" ]; then
            _x11_wd_ver="3.9"
            # v3.16 — lockdir do watchdog saiu de $ROOTFS/var/lock: em imagem
            # nova (Debian/usrmerge) /var/lock e' SYMLINK para /run/lock — path
            # ABSOLUTO que, pre-pivot, resolve no HOST e da ENOENT. O `mkdir -p`
            # nao guardado MATAVA o script (exit=1, terminal vazio). Agora usa o
            # dir de estado que criamos nos, que e' diretorio de verdade.
            _x11_wd_lock="$_STD/watchdog"
            _x11_wd_old="$(cat "$_x11_wd_lock/pid" 2>/dev/null || true)"
            if [ -n "$_x11_wd_old" ] && kill -0 "$_x11_wd_old" 2>/dev/null && \
                head -c 256 2>/dev/null "/proc/$_x11_wd_old/cmdline" | grep -q 'x11-watchdog' && \
                [ "$(cat "$_x11_wd_lock/ver" 2>/dev/null || true)" = "$_x11_wd_ver" ]; then
                _x11_wd_pid="$_x11_wd_old"
            else
                # Watchdog ausente/antigo (ex.: v3.4 de APK anterior ainda ativo):
                # mata SO esse processo, senao ele restauraria o TMPDIR antigo e
                # brigaria com o servidor compartilhado.
                if [ -n "$_x11_wd_old" ]; then
                    kill "$_x11_wd_old" 2>/dev/null || true
                fi
                rm -rf "$_x11_wd_lock" 2>/dev/null || true
                mkdir -p "$_x11_wd_lock" 2>/dev/null || true
                if [ ! -d "$_x11_wd_lock" ] || [ ! -w "$_x11_wd_lock" ]; then
                    bootinfo "X11: AVISO lockdir do watchdog indisponivel ($_x11_wd_lock) — sem auto-recuperacao do X"
                    _x11_wd_lock=""
                fi
                if [ -n "$_x11_wd_lock" ]; then
                # v3.16 — imagem minima pode nao ter /usr/local/bin
                mkdir -p "$ROOTFS/usr/local/bin" 2>/dev/null || true
                if ! : > "$ROOTFS/usr/local/bin/x11-watchdog" 2>/dev/null; then
                    bootinfo "X11: AVISO nao foi possivel escrever /usr/local/bin/x11-watchdog — sem auto-recuperacao do X"
                    _x11_wd_lock=""
                fi
            fi
            if [ -n "$_x11_wd_lock" ]; then
                cat > "$ROOTFS/usr/local/bin/x11-watchdog" <<'EOF'
#!/system/bin/sh
# tuxbox x11 watchdog v3.9 — servidor X COMPARTILHADO entre abas/containers.
# O scratch do servidor vive dentro do rootfs (TX11_TMP = $ROOTFS/var/lib/
# tuxbox-x11, visivel como /var/lib/tuxbox-x11 em TODO container do mesmo
# rootfs); monitoramos o listener real em /proc/net/unix. Restore serializado
# por flock (TX11_XS_LOCK): so' o primeiro a pegar o lock relaunca; os demais
# re-checam e desistem. Singleton por lockdir+pid (TX11_LOCK). Env: TX11_TMP,
# TX11_XKB, TX11_APK, TX11_LOCK, TX11_LOG, TX11_SLOG, TX11_RUNTIME,
# TX11_CRUNTIME, TX11_XS_LOCK.
_listen() { # 1 se algo ESCUTA no socket dado (0 = ausente ou morto)
    [ -S "$1" ] || return 1
    awk -v p="$1" 'NR>1 && $NF==p && $6=="01" {f=1} END {exit !f}' \
        /proc/net/unix 2>/dev/null
}
_wd_alive() { # singleton validado: pid vivo E e' mesmo o watchdog
    [ -r "$TX11_LOCK/pid" ] || return 1
    _p="$(cat "$TX11_LOCK/pid" 2>/dev/null)" || return 1
    kill -0 "$_p" 2>/dev/null || return 1
    # v3.15 — 2>/dev/null ANTES da leitura: se o processo morrer entre o glob e
    # o read, o mksh imprime "can't open /proc/N/cmdline" no terminal (o
    # redirect de stderr depois do de entrada nao cobre a falha da abertura).
    head -c 256 2>/dev/null "/proc/$_p/cmdline" | grep -q 'x11-watchdog' || return 1
}
if _wd_alive; then
    exit 0
fi
mkdir -p "$TX11_LOCK" 2>/dev/null || exit 0
echo $$ > "$TX11_LOCK/pid" 2>/dev/null || exit 0
echo "3.9" > "$TX11_LOCK/ver" 2>/dev/null || true
trap 'rm -rf "$TX11_LOCK"' EXIT 2>/dev/null || true
mkdir -p "$TX11_RUNTIME" "$TX11_CRUNTIME" "$TX11_TMP/.X11-unix" 2>/dev/null || true
echo "[wd $(date +%H:%M:%S)] start pid=$$ tmp=$TX11_TMP"
echo "[wd $(date +%H:%M:%S)] xkb_dir=$([ -d "$TX11_XKB" ] && echo 1 || echo 0) apk=$([ -f "$TX11_APK" ] && echo 1 || echo 0) runtime=$TX11_RUNTIME"
_n=0
while :; do
    _lA=0; _lB=0
    _listen "$TX11_TMP/xvfb.sock" && _lA=1
    _listen "$TX11_TMP/.X11-unix/X0" && _lB=1
    if [ "$_lA" = "1" ] || [ "$_lB" = "1" ]; then
        # servidor vivo (ALGUEM escuta de verdade) — o symlink ja o expoe.
        _n=$((_n + 1))
        if [ $((_n % 10)) -eq 0 ]; then
            echo "[wd $(date +%H:%M:%S)] saude ok lA=$_lA lB=$_lB" \
                > "$TX11_TMP/wd-state" 2>/dev/null
            echo "[wd $(date +%H:%M:%S)] ok lA=$_lA lB=$_lB"
        fi
    else
        echo "[wd $(date +%H:%M:%S)] sem listener -> restaurando (arqA=$([ -S "$TX11_TMP/xvfb.sock" ]&&echo 1||echo 0) arqB=$([ -S "$TX11_TMP/.X11-unix/X0" ]&&echo 1||echo 0))" \
            | tee "$TX11_TMP/wd-state"
        # Restore serializado no lock compartilhado; re-checa com o lock na
        # mao (outra aba/outro watchdog pode ja ter ressuscitado o servidor).
        ( flock -n 9 2>/dev/null || true
          if _listen "$TX11_TMP/xvfb.sock" || _listen "$TX11_TMP/.X11-unix/X0"; then
              exit 0
          fi
          pkill -f 'com.termux.x11.CmdEntryPoint' 2>/dev/null || true
          pkill -f 'termux-x11' 2>/dev/null || true
          sleep 1
          rm -f "$TX11_TMP/xvfb.sock" "$TX11_TMP/.X11-unix/X0" \
              "$TX11_TMP/.X11-unix/.X0-lock" 2>/dev/null || true
          mkdir -p "$TX11_TMP/.X11-unix" "$TX11_RUNTIME" "$TX11_CRUNTIME" 2>/dev/null || true
          echo "[wd $(date +%H:%M:%S)] launch app_process TMPDIR=$TX11_TMP XKB=$TX11_XKB"
          TMPDIR="$TX11_TMP" \
          XKB_CONFIG_ROOT="$TX11_XKB" \
          XDG_RUNTIME_DIR="$TX11_RUNTIME" \
          CLASSPATH="$TX11_APK" \
          setsid /system/bin/app_process / --nice-name=termux-x11 \
              com.termux.x11.CmdEntryPoint :0 \
              >> "$TX11_SLOG" 2>&1 9>&- &
          _i=0
          while [ "$_i" -lt 100 ]; do
              if _listen "$TX11_TMP/xvfb.sock" || _listen "$TX11_TMP/.X11-unix/X0"; then
                  break
              fi
              _i=$((_i + 1))
              sleep 0.4
          done
          echo "[wd $(date +%H:%M:%S)] restaurado (wait=$_i lA=$(_listen "$TX11_TMP/xvfb.sock" && echo 1 || echo 0) lB=$(_listen "$TX11_TMP/.X11-unix/X0" && echo 1 || echo 0))" \
              | tee -a "$TX11_TMP/wd-state"
          am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity >/dev/null 2>&1 || true
        ) 9>"$TX11_XS_LOCK" 2>/dev/null || true
    fi
    echo "$(date +%s)" > "$TX11_LOCK/heartbeat" 2>/dev/null || true
    sleep 1
done
EOF
                chmod 755 "$ROOTFS/usr/local/bin/x11-watchdog" || true
                set +e
                TX11_TMP="$_SRV" \
                TX11_XKB="$(cat "$_XS_XKB" 2>/dev/null || echo "$ROOTFS/usr/share/X11/xkb")" \
                TX11_APK="$_tx11_apk" TX11_LOCK="$_x11_wd_lock" \
                TX11_LOG="$ROOTFS/var/log/termux-x11-wd.log" \
                TX11_SLOG="$_XS_SLOG" TX11_RUNTIME="$_XS_RUN" \
                TX11_CRUNTIME="$ROOTFS/run/user/0" TX11_XS_LOCK="$_XS_LOCK" \
                    setsid unshare -m "$ROOTFS/usr/local/bin/x11-watchdog" \
                    >> "$ROOTFS/var/log/termux-x11-wd.log" 2>&1 &
                set -e
                sleep 0.3
                if [ -r "$_x11_wd_lock/pid" ]; then
                    _x11_wd_pid="$(cat "$_x11_wd_lock/pid" 2>/dev/null)"
                    bootinfo "X11: watchdog v3.9 ativo (pid $_x11_wd_pid): servidor compartilhado reinicia sozinho se cair"
                else
                    echo "[tuxbox] X11: AVISO: watchdog nao subiu (lock ausente)" >&2
                fi
            fi
            fi
            fi
            # Diagnostico v3.9: estado real do listener compartilhado pos-waits
            if [ "${_x11_shared:-0}" != "1" ] && \
               ! { _x11_listen "$_SRV/xvfb.sock" || _x11_listen "$_SRV/.X11-unix/X0"; }; then
                bootinfo "X11: DIAG: sem listener compartilhado pos-waits; -S X0=$([ -S "$_SRV/.X11-unix/X0" ] && echo 1 || echo 0) xvfb=$([ -S "$_SRV/xvfb.sock" ] && echo 1 || echo 0); proc=$(grep -c '.X11-unix' /proc/net/unix 2>/dev/null || echo 0) linha(s)"
            fi
            if [ "$_X11_LINK" = "1" ]; then
                _tx11_ok=1
                # v3.14 — GERENCIADOR DE JANELAS AUTOMATICO. Antes era preciso
                # digitar `openbox --sm-disable &` a CADA aba. Ele sobe junto
                # com o X, no mesmo namespace/ciclo de vida (se a aba que subiu
                # o X fechar, o WM morre junto e a proxima aba o religa).
                # Escolha do WM:
                #   /root/.wm com o comando  -> usa esse ("i3", "fluxbox", ...)
                #   /root/.wm vazio/"none"   -> nao sobe WM nenhum
                #   sem /root/.wm            -> openbox --sm-disable (padrao)
                # Roda via `chroot $ROOTFS` (libs do container) + `setsid`
                # (independente do shell da aba). Singleton por /proc: como o
                # display :0 e compartilhado, dois WMs brigariam entre si.
                _wm_cmd=""; _wm_bin=""
                if [ "${_x11_shared:-0}" = "1" ]; then
                    :
                elif [ -f "$ROOTFS/root/.wm" ]; then
                    _wm_cmd="$(sed -n 1p "$ROOTFS/root/.wm" 2>/dev/null | tr -d '\r')"
                    case "$_wm_cmd" in
                        ""|none|off) _wm_cmd="" ;;
                        *) _wm_bin="${_wm_cmd%% *}" ;;
                    esac
                elif [ -x "$ROOTFS/usr/bin/openbox" ]; then
                    _wm_cmd="openbox --sm-disable"
                    _wm_bin="openbox"
                fi
                if [ -n "$_wm_cmd" ]; then
                    # v3.14 — singleton: casa pelo argv[0] (o binario do WM),
                    # e nao por "/openbox" em qualquer lugar da cmdline — senao
                    # qualquer shell que tenha o nome no texto (o proprio script
                    # de teste, um grep, um bash -c) contaria como WM ativo.
                    _wm_pid=""
                    for _f in /proc/[0-9]*/cmdline; do
                        _a0="$(tr '\0' '\n' 2>/dev/null < "$_f" | sed -n 1p)" || continue
                        [ -n "$_a0" ] || continue
                        case "${_a0##*/}" in
                            "$_wm_bin")
                                _wm_pid="${_f#/proc/}"
                                _wm_pid="${_wm_pid%/cmdline}"
                                break ;;
                        esac
                    done
                    if [ -n "$_wm_pid" ]; then
                        bootinfo "X11: gerenciador de janelas ja ativo ($_wm_cmd, pid $_wm_pid)"
                    else
                        _wm_rel=""
                        for _d in usr/bin bin usr/local/bin; do
                            if [ -x "$ROOTFS/$_d/$_wm_bin" ]; then
                                _wm_rel="$_d/$_wm_bin"
                                break
                            fi
                        done
                        if [ -z "$_wm_rel" ]; then
                            bootinfo "X11: gerenciador de janelas ausente ($_wm_cmd) — instale: apt install -y openbox"
                        else
                            # env do proprio container (o chroot roda no rootfs;
                            # /usr/bin/env nao e garantido em toda distro)
                            _wm_env="/usr/bin/env"
                            for _d in usr/bin bin usr/local/bin; do
                                if [ -x "$ROOTFS/$_d/env" ]; then
                                    _wm_env="$_d/env"
                                    break
                                fi
                            done
                            # v3.14 — caminhos ABSOLUTOS dentro do chroot: com
                            # caminho relativo o exec falha (o CWD nao existe
                            # mais depois do chroot) — "No such file or
                            # directory" no log do WM.
                            setsid chroot "$ROOTFS" "/$_wm_env" -i \
                                DISPLAY=:0 XKB_CONFIG_ROOT=/usr/share/X11/xkb \
                                XDG_RUNTIME_DIR=/run/user/0 HOME=/root \
                                PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
                                "/$_wm_rel" ${_wm_cmd#"$_wm_bin"} \
                                >> "$ROOTFS/var/log/x11-wm.log" 2>&1 < /dev/null &
                            sleep 0.6
                            # setsid pode ter forkado: procura o pid real pelo argv[0]
                            for _f in /proc/[0-9]*/cmdline; do
                                _a0="$(tr '\0' '\n' 2>/dev/null < "$_f" | sed -n 1p)" || continue
                                [ -n "$_a0" ] || continue
                                case "${_a0##*/}" in
                                    "$_wm_bin")
                                        _wm_pid="${_f#/proc/}"
                                        _wm_pid="${_wm_pid%/cmdline}"
                                        break ;;
                                esac
                            done
                            if [ -n "$_wm_pid" ]; then
                                bootinfo "X11: gerenciador de janelas iniciado: $_wm_cmd (pid $_wm_pid)"
                            else
                                warn "gerenciador de janelas nao subiu: $_wm_cmd (log: /var/log/x11-wm.log)"
                            fi
                        fi
                    fi
                fi
                # Abre a tela do termux-x11 (fica em primeiro plano no aparelho).
                am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity \
                    >/dev/null 2>&1 || true
                bootinfo "X11: termux-x11 em :0 -> DISPLAY=:0 (symlink /tmp/.X11-unix/X0)"
                bootinfo "X11: GL nesta aba via llvmpipe; Vulkan (Turnip/kgsl) na GPU"
                bootinfo "X11: GLX/GL na GPU: touch /root/.gui_gl_kgsl (kgsl, recomendado) ou /root/.gui_gl_zink (zink)"
                X11_ENV="DISPLAY=:0 XKB_CONFIG_ROOT=/usr/share/X11/xkb XDG_RUNTIME_DIR=/run/user/0"
            else
                echo "[tuxbox] X11: servidor termux-x11 nao subiu (log: $_XS_SLOG)" >&2
                tail -8 "$_XS_SLOG" 2>/dev/null >&2 || true
            fi
            echo "[tuxbox] X11: boot $(date +%H:%M:%S) ok=$_tx11_ok wd=$_x11_wd_pid" \
                | tee -a "$ROOTFS/var/log/tuxbox-x11-boot.log" >/dev/null
        else
            echo "[tuxbox] X11: app Termux:X11 (com.termux.x11) nao instalado no aparelho" >&2
        fi
    fi

    mkdir -p "$ROOTFS/old_root" && cd "$ROOTFS"
    pivot_root . old_root && cd /
    TB_BOOT_LOG="/var/log/tuxbox-boot.log"

    # Mesa env vars para o driver nativo.
    # 1) Sem /dev/dri (kernel Android com kgsl): usa o backend kgsl da Mesa
    #    custom (mesa-for-android-container), se instalada no rootfs.
    # 2) Com /dev/dri: o Mesa auto-detecta o driver pelo node DRM — EXCETO
    #    kernels mainline >=6.5, que renomearam o driver msm -> msm_drm: o
    #    loader do Mesa stock não mapeia "msm_drm" pra freedreno e cai em
    #    llvmpipe. Nesse caso forçamos o driver pelo nome (freedreno/panfrost).
    GPU_ENV=""
    if [ "${GUI:-0}" = "1" ]; then
        # GUI remota (termux-x11). O padrao e' GL/GLX em llvmpipe (software,
        # estavel) e Vulkan na GPU via Turnip/kgsl — de proposito.
        # Para ACELERAR O GL na GPU existem dois modos (Mesa 26.x do
        # mesa-for-android-container, backend KGSL do Freedreno):
        #     touch /root/.gui_gl_kgsl   # GL direto na GPU (recomendado upstream)
        #     touch /root/.gui_gl_zink   # GL via zink -> Turnip
        # v3.18 — os arquivos sao lidos no HOST (o bloco X roda pre-pivot) E
        # dentro do container ($ROOTFS/root): antes o "touch" feito no terminal
        # do container nao ativava nada, porque o script so olhava o /root do
        # aparelho.
        _gl_mode=""
        if [ -e /root/.gui_gl_kgsl ] || [ -e "$ROOTFS/root/.gui_gl_kgsl" ]; then
            _gl_mode="kgsl"
        elif [ -e /root/.gui_gl_zink ] || [ -e "$ROOTFS/root/.gui_gl_zink" ]; then
            _gl_mode="zink"
        fi
        case "$_gl_mode" in
            kgsl) GPU_ENV="TU_DEBUG=noconform MESA_LOADER_DRIVER_OVERRIDE=kgsl" ;;
            zink) GPU_ENV="TU_DEBUG=noconform MESA_LOADER_DRIVER_OVERRIDE=zink" ;;
            *)    GPU_ENV="TU_DEBUG=noconform" ;;
        esac
        bootinfo "X11: GL (OpenGL/GLES): ${_gl_mode:-llvmpipe/software} | Vulkan: Turnip/kgsl na GPU"
    # 1) GPU via kgsl (kernel downstream/híbrido): /dev/kgsl-3d0 presente e a
    #    Mesa custom com backend kgsl no rootfs. É o caminho do droidspaces:
    #    Turnip (Vulkan) + GL nativo via kgsl. Tem prioridade sobre /dev/dri,
    #    porque em ROMs híbridas o /dev/dri costuma ser só o display (SDE).
    elif [ "${HAS_KGSL_MESA:-0}" = "1" ] && [ -e /dev/kgsl-3d0 ]; then
        GPU_ENV="MESA_LOADER_DRIVER_OVERRIDE=kgsl TU_DEBUG=noconform"
    # 2) GPU via DRM (kernel mainline): /dev/dri exposto de verdade. Kernels
    #    >=6.5 renomearam o driver msm -> msm_drm e o loader do Mesa stock não
    #    mapeia esse nome; forçamos o driver conhecido (freedreno/panfrost).
    elif [ -e /dev/dri/card0 ] || [ -e /dev/dri/renderD128 ]; then
        DRM_DRV=""
        for uevent in /sys/class/drm/*/device/uevent; do
            [ -r "$uevent" ] || continue
            DRM_DRV=$(sed -n 's/^DRIVER=//p' "$uevent" 2>/dev/null | head -1)
            [ -n "$DRM_DRV" ] && break
        done
        case "$DRM_DRV" in
            msm*|kgsl) GPU_ENV="MESA_LOADER_DRIVER_OVERRIDE=freedreno" ;;
            panfrost|panthor) GPU_ENV="MESA_LOADER_DRIVER_OVERRIDE=panfrost" ;;
        esac
    fi

    # Resumo de GPU vai pro log do container (bootinfo), não pro terminal.
    if [ "${HAS_KGSL_MESA:-0}" = "1" ] && [ -e /dev/kgsl-3d0 ]; then
        if [ "${GUI:-0}" = "1" ]; then
            # v3.18 — mesma deteccao dos modos de GL (host + container)
            if [ -e /root/.gui_gl_kgsl ] || [ -e "$ROOTFS/root/.gui_gl_kgsl" ]; then
                bootinfo "GPU: kgsl ativo -> GL/GLES via kgsl; Vulkan Turnip na GPU"
            elif [ -e /root/.gui_gl_zink ] || [ -e "$ROOTFS/root/.gui_gl_zink" ]; then
                bootinfo "GPU: kgsl ativo -> GLX via zink (Turnip); Vulkan Turnip na GPU"
            else
                bootinfo "GPU: kgsl ativo -> Vulkan Turnip na GPU; GL no X11 via llvmpipe"
            fi
        else
            bootinfo "GPU: /dev/kgsl-3d0 -> Mesa kgsl (Turnip via kgsl)"
        fi
    elif [ -e /dev/dri/card0 ]; then
        bootinfo "GPU: /dev/dri ligado -> DRM nativo${GPU_ENV:+ (override: ${GPU_ENV%% *})}"
    else
        bootinfo "GPU: sem GPU nativa -> llvmpipe (software)"
    fi

    # On Termux with tsu, chroot immediately after pivot_root is required
    exec chroot . env -i \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        HOME=/root \
        TERM=xterm-256color \
        container=tuxbox \
        $GPU_ENV \
        $X11_ENV \
        /bin/sh -c 'cd; umount -l /old_root && rmdir /old_root; exec "$@"' -- "$@"
fi

# === Networking functions ===
check_ip_rule() { ip rule list | grep -q "$1"; }

add_ipt_rule() {
    cmd="$1"; shift

    check_args=""
    for arg in "$@"; do
        case "$arg" in
            -A|-I) check_args="$check_args -C" ;;
            *) check_args="$check_args $arg" ;;
        esac
    done

    $cmd $check_args 2>/dev/null || "$cmd" "$@"
}

get_next_ip() {
    count=2
    for ns in "$NETNS_DIR"/"$BRIDGE"-*; do
        [ -e "$ns" ] && count=$((count + 1))
    done
    echo "${NET_PREFIX}.${count}"
}

find_free_subnet() {
    octet=1
    while [ "$octet" -lt 254 ]; do
        if [ "$1" = "4" ]; then
            candidate="10.11.${octet}.0${SUBNET}"
            if ! ip route | grep -q "$candidate"; then
                NET_PREFIX="10.11.${octet}"
                BRIDGE_SUBNET="${NET_PREFIX}.0${SUBNET}"
                BRIDGE_IP="${NET_PREFIX}.1"
                return 0
            fi
        else
            hex=$(printf '%02x' "$octet")
            candidate="fd${hex}::${SUBNET6}"
            if ! ip -6 r l t all | grep -q "$candidate"; then
                NET6_PREFIX="fd${hex}::"
                BRIDGE_SUBNET6="${NET6_PREFIX}${SUBNET6}"
                BRIDGE_IP6="${NET6_PREFIX}1"
                return 0
            fi
        fi
        octet=$((octet + 1))
    done
}

cleanup_custom_routes() {
    [ -f "$RT_DIR/custom_routes" ] || return 0
    while read -r prio ip4 ip6 table; do
        ip rule del from "$ip4" lookup "$table" priority "$prio" 2>/dev/null
        ip -6 rule del from "$ip6" lookup "$table" priority "$prio" 2>/dev/null
    done < "$RT_DIR/custom_routes"
    rm -f -- "$RT_DIR/custom_routes" && exit 0
}

# If port ranges overlap, the most recently started
# container takes precedence in the port forwarding rules
setup_port_forward() {
    ct_ip4="$1"
    ct_ip6="${NET6_PREFIX}${1##*.}"

    if [ -z "$WAN_IF" ]; then
        if [ "${ANDROID:-}" = "1" ]; then
            WAN_IF=$(ip link show wlan0 >/dev/null 2>&1 && echo "wlan0" || echo "eth0")
        else
            WAN_IF=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $5; exit}')
        fi
        [ -z "$WAN_IF" ] && WAN_IF="eth0"
    fi

    for proto in tcp udp; do
        add_ipt_rule iptables  -t nat -I PREROUTING -i "$WAN_IF" -p "$proto" --dport "$PORT_RANGE" -j DNAT --to-destination "$ct_ip4"
        add_ipt_rule ip6tables -t nat -I PREROUTING -i "$WAN_IF" -p "$proto" --dport "$PORT_RANGE" -j DNAT --to-destination "$ct_ip6"
    done

    # Don't forward Termux ssh
    [ "${ANDROID:-}" = "1" ] && for ipt_cmd in iptables ip6tables; do
        "$ipt_cmd" -t nat -D PREROUTING -p tcp --dport 8022 -j RETURN 2>/dev/null || true
        "$ipt_cmd" -t nat -I PREROUTING -p tcp --dport 8022 -j RETURN
    done || true
}

setup_bridge() {
    if ! ip link show "$BRIDGE" >/dev/null 2>&1; then
        ip link add name "$BRIDGE" type bridge
        ip addr add "${BRIDGE_IP}${SUBNET}" dev "$BRIDGE"
        ip -6 addr add "${BRIDGE_IP6}${SUBNET6}" dev "$BRIDGE"
        ip link set "$BRIDGE" up
        info "Bridge $BRIDGE created"
    fi

    #  IP forward and NAT
    echo 1 > /proc/sys/net/ipv4/ip_forward
    echo 1 > /proc/sys/net/ipv6/conf/all/forwarding

    # It would be nice if we could just use netd, unfortunately, it only NAT for IPv4.
#    ndc nat enable "$BRIDGE" "$iface" 1 >/dev/null
    add_ipt_rule iptables  -t nat -I POSTROUTING -s "$BRIDGE_SUBNET" ! -d "$BRIDGE_SUBNET" -j MASQUERADE
    add_ipt_rule ip6tables -t nat -I POSTROUTING -s "$BRIDGE_SUBNET6" ! -d "$BRIDGE_SUBNET6" -j MASQUERADE

    for ipt_cmd in iptables ip6tables; do
        add_ipt_rule "$ipt_cmd" -t filter -I INPUT   -i "$BRIDGE" -j ACCEPT
        add_ipt_rule "$ipt_cmd" -t filter -I OUTPUT  -o "$BRIDGE" -j ACCEPT
        add_ipt_rule "$ipt_cmd" -t filter -I FORWARD -i "$BRIDGE" -j ACCEPT
        add_ipt_rule "$ipt_cmd" -t filter -I FORWARD -o "$BRIDGE" -j ACCEPT
    done
}

setup_netns() {
    ct_ip4="$1"
    ct_ip6="${NET6_PREFIX}${ct_ip4##*.}"

    veth="veth_${VETH_NAME}"
    peer="eth0_${VETH_NAME}"

    if [ ! -e "$NETNS_DIR/$NETNS_NAME" ]; then
        ip netns add "$NETNS_NAME"
        info "Created netns: $NETNS_NAME"
    else
        info "Reuse netns: $NETNS_NAME"
    fi

    if ! ip link show "$veth" >/dev/null 2>&1; then
        ip link add "$veth" type veth peer name "$peer"
        ip link set "$veth" master "$BRIDGE"
        ip link set "$veth" up
        ip link set "$peer" netns "$NETNS_NAME"

        ns_exec="ip netns exec $NETNS_NAME"
        $ns_exec ip link set lo up
        $ns_exec ip link set "$peer" up
        $ns_exec ip addr add "${ct_ip4}${SUBNET}" dev "$peer"
        $ns_exec ip route add default via "$BRIDGE_IP"
        $ns_exec ip -6 addr add "${ct_ip6}${SUBNET6}" dev "$peer"
        $ns_exec ip -6 route add default via "$BRIDGE_IP6"
        info "Created veth pair for $HOSTNAME ($ct_ip4, $ct_ip6)"
    fi
}

# Android policy-based routing quirks
# On Android, if VPN apps are installed on both the work and main profiles,
# the first one to connect creates the 'tun0' interface, and the next creates 'tun1'.
# Some custom ROMs allow multiple profiles to be active simultaneously, making it
# possible to have even more routing tables (e.g., tun2, tun3, tun4,...).
# The goal of this function is to have a baseline working connectivity.
setup_android_routing() {
    vpn="tun0 tun1"

    ip_rule_add() {
        table="$1"; prio="$2"
        ip rule del priority "$prio" 2>/dev/null || true
        ip rule add iif "$BRIDGE" lookup "$table" priority "$prio"
        ip -6 rule del priority "$prio" 2>/dev/null || true
        ip -6 rule add iif "$BRIDGE" lookup "$table" priority "$prio"
    }

    ip route replace "$BRIDGE_SUBNET" dev "$BRIDGE" table local_network
    ip -6 route replace "$BRIDGE_SUBNET6" dev "$BRIDGE" table local_network

    # Ensure hotspot clients can reach container directly
    ip_rule_add local_network "$BRIDGE_PRIO_BASE"

    # VPN tunnels
    for table in $vpn; do
        check_ip_rule "lookup $table" && ip_rule_add "$table" "$(($BRIDGE_PRIO_BASE + $VPN_PRIO))"
    done

    # Wifi or ethernet
    for table in wlan0 eth0; do
        check_ip_rule "lookup $table" && ip_rule_add "$table" "$(($BRIDGE_PRIO_BASE + $WIFI_PRIO))"
    done

    # Cellular
    for table in $MOBILE_DATA_IFACE; do
        if check_ip_rule "lookup $table"; then
            ip_rule_add "$table" "$(($BRIDGE_PRIO_BASE + $MOBILE_PRIO))"
        fi
    done

    # The approach above is more effective, keep this here for future reference
#    for iface in $vpn wlan0 eth0 $MOBILE_DATA_IFACE; do
#        if check_ip_rule "lookup $iface"; then
#            ndc ipfwd remove "$BRIDGE" "$iface" >/dev/null
#            ndc ipfwd add "$BRIDGE" "$iface" >/dev/null
#        fi
#    done
}

# Now to the good part, this function sets up per-container routing
# so you can pin specific containers to specific interfaces.
# Container at .2 goes through tun0, .3 through wlan0, etc.
# When the interface drops, the table goes blank and the kernel
# falls through to the next rule. Free failover, zero code.
android_custom_routing() {
    [ -z "${ROUTE_VIA:-}" ] && return 0
    if ! check_ip_rule "lookup $ROUTE_VIA"; then
        die "--route-via $ROUTE_VIA: no routing table found (interface down?)"
    fi
    ct_ip4="$1"

    if [ -n "${CT_IP6:-}" ]; then
        ct_ip6="$CT_IP6"
    else
        ct_ip6="${NET6_PREFIX}${ct_ip4##*.}"
    fi

    # Extract the last two octets
    last_two="${ct_ip4#*.*.}"
    third_octet="${last_two%%.*}"
    fourth_octet="${last_two##*.}"

    prio=$((5000 + (third_octet * 10) + fourth_octet))

    ip rule del from "$ct_ip4" priority "$prio" 2>/dev/null || true
    ip rule add from "$ct_ip4" lookup "$ROUTE_VIA" priority "$prio"
    ip -6 rule del from "$ct_ip6" priority "$prio" 2>/dev/null || true
    ip -6 rule add from "$ct_ip6" lookup "$ROUTE_VIA" priority "$prio"
    mkdir -p "$RT_DIR"
    echo "$prio $ct_ip4 $ct_ip6 $ROUTE_VIA" >> "$RT_DIR/custom_routes"
    info "Routing $ct_ip4 ($ct_ip6) via $ROUTE_VIA"
}

# === Phase 1 ===
usage() {
    cat <<EOF

Usage: tuxbox [OPTIONS] <rootfs> [command...]

Options:
  -N, --net                   Enable network namespace
  -G, --gui                   Start termux-x11 server (graphical interface, DISPLAY=:0)
  -P, --port-range START:END  Port forwarding range (requires --net)
  -R, --route-via IFACE       Route container through specific interface (requires --net)
  -C, --cleanup-route         Remove all custom --route-via rules and exit
  -h, --help                  Show this help

EOF
    exit 0
}

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            ;;
        -N|--net)
            USE_NETNS=1
            shift
            ;;
        -G|--gui)
            GUI=1
            shift
            ;;
        -P|--port-range)
            [ $# -lt 2 ] && die "--port-range requires START:END"
            PORT_RANGE="$2"
            [ -n "${PORT_RANGE:-}" ] && [ "${USE_NETNS:-}" != "1" ] && die "--port-range requires --net"
            case "$PORT_RANGE" in
                *:*) ;;
                *) die "Invalid port range format. Use START:END (e.g., 1080:30000)" ;;
            esac
            shift 2
            ;;
        -R|--route-via)
            [ $# -lt 2 ] && die "--route-via requires interface name (e.g., tun0, wlan0)"
            ROUTE_VIA="$2"
            [ -n "${ROUTE_VIA:-}" ] && [ "${USE_NETNS:-}" != "1" ] && die "--route-via requires --net"
            shift 2
            ;;
        -C|--cleanup-route)
            [ "$(id -u)" -eq 0 ] || die "Must be root"
            cleanup_custom_routes
            ;;
        -V|--version)
            echo "tuxbox version $VERSION"
            exit 0
            ;;
        -*)
            die "Unknown option: $1"
            ;;
        *)
            break
            ;;
    esac
done

if [ $# -eq 0 ]; then usage; fi

ROOTFS="$1"
shift
TB_BOOT_LOG="$ROOTFS/var/log/tuxbox-boot.log"

# v3.10 — o `trap ... ERR` daqui era o segundo assassino silencioso (v3.9e/v3.9f):
# no mksh do Android `trap ... ERR` falha e o set -e encerra o script com exit=1
# ANTES do primeiro bootinfo (fase1: args ok) — por isso o terminal ficava vazio e
# o boot log sem nenhuma linha nova. Guardado: diagnostica onde ha ERR, e ignora
# onde nao ha. Mantidos: o marcador early (v3.9f), a protecao OOM e o bootinfo.
# v3.11 — `set -E` REMOVIDO: no mksh do Android esta opção é desconhecida e
# ABORTA o shell com rc=1 ignorando o `|| true` (é a causa raiz do exit=1 sem
# log). O `trap ... ERR` (testado no mksh: suportado e inofensivo guardado)
# continua como diagnóstico.
trap 'echo "[tuxbox] P1-DIE $(date +%H:%M:%S) LINHA=$LINENO rc=$?" >> "${TB_BOOT_LOG:-/dev/null}" 2>/dev/null || true' ERR 2>/dev/null || true
echo -1000 > /proc/self/oom_score_adj 2>/dev/null || true
bootinfo "fase1: args ok rootfs=$ROOTFS gui=${GUI:-0} net=${USE_NETNS:-0}"

[ -d "$ROOTFS" ] || die "Rootfs not found"

[ "$(id -u)" -eq 0 ] || die "Must be root"

# Custom ROMs often omit the /dev/kgsl-3d0 node from ueventd even though the
# kernel has the GPU driver (CONFIG_QCOM_KGSL). Recreate it from sysfs; if the
# kernel doesn't export a devt (missing 'dev' attr), fall back to the ROM's own
# ueventd.rc entry, and finally to the classic 511:0 used by Qualcomm Adreno.
if [ ! -e /dev/kgsl-3d0 ]; then
    _kgsl_major=""
    _kgsl_minor="0"
    if [ -r /sys/class/kgsl/kgsl-3d0/dev ]; then
        _kgsl_dev=$(cat /sys/class/kgsl/kgsl-3d0/dev 2>/dev/null || true)
        case "$_kgsl_dev" in
            *:*)
                _kgsl_major="${_kgsl_dev%%:*}"
                _kgsl_minor="${_kgsl_dev##*:}"
                ;;
        esac
    fi
    if [ -z "$_kgsl_major" ]; then
        _ueventd_line=$(grep -h -m1 "^/dev/kgsl-3d0[[:space:]]" \
            /vendor/ueventd.rc /ueventd.rc /system/etc/ueventd.rc \
            2>/dev/null | head -1 || true)
        _kgsl_major=$(echo "$_ueventd_line" | awk '{print $(NF-1)}')
        _kgsl_minor=$(echo "$_ueventd_line" | awk '{print $NF}')
        case "$_kgsl_major" in
            ''|*[!0-9]*) _kgsl_major="511" ;;
        esac
        case "$_kgsl_minor" in
            ''|*[!0-9]*) _kgsl_minor="0" ;;
        esac
    fi
    if [ -n "$_kgsl_major" ]; then
        mknod /dev/kgsl-3d0 c "$_kgsl_major" "$_kgsl_minor" 2>/dev/null || true
        chmod 0666 /dev/kgsl-3d0 2>/dev/null || true
        bootinfo "kgsl: criado /dev/kgsl-3d0 (${_kgsl_major}:${_kgsl_minor})"
    fi
fi
kernel_version=$(uname -r)
major=$(echo "$kernel_version" | cut -d. -f1)
minor=$(echo "$kernel_version" | cut -d. -f2)
if [ "$major" -lt 4 ] || { [ "$major" -eq 4 ] && [ "$minor" -lt 19 ]; }; then
    die "Kernel version must be >= 4.19"
fi

ROOTFS=$(cd "$ROOTFS" && pwd -P)
# Arch's pacman 7 uses a Landlock download sandbox.  Most Android kernels do
# not expose Landlock, so make the container's pacman usable automatically.
_TUXBOX_BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd || true)
if [ -n "$_TUXBOX_BIN_DIR" ] && [ -x "$_TUXBOX_BIN_DIR/ensure-pacman" ]; then
    "$_TUXBOX_BIN_DIR/ensure-pacman" "$ROOTFS" || true
fi
HOSTNAME=$(basename "$ROOTFS" | tr '_' '-')

check_ns() { unshare "$1" true 2>/dev/null; }

# Setup networking if requested
if [ "${USE_NETNS:-}" = "1" ]; then
    if ! check_ns -n; then
        die "--net require kernel with network namespace support"
    fi

    if command -v ip >/dev/null 2>&1; then
        if readlink "$(command -v ip)" 2>/dev/null | grep -q busybox; then
            die "--net require ip command from iproute2"
        fi
    else
        die "--net require ip command from iproute2"
    fi

    if ! command -v iptables >/dev/null 2>&1; then
        die "--net require iptables command"
    fi

    HASH_TOOL=$(command -v md5sum || echo cksum)
    BRIDGE_HASH=$(printf '%s' "$BRIDGE" | $HASH_TOOL | awk '{print $1}')
    BRIDGE_PRIO_BASE=$((6000 + 0x${BRIDGE_HASH%%????????????????????????} % 1000))
    NETNS_NAME="$BRIDGE-$(printf '%s' "$BRIDGE_HASH$ROOTFS" | $HASH_TOOL | awk '{print substr($1,1,8)}')"
    VETH_NAME="$(printf '%s' "$BRIDGE_HASH$NETNS_NAME" | $HASH_TOOL | awk '{print substr($1,1,8)}')"

    if ! ip link show "$BRIDGE" >/dev/null 2>&1; then
        if ip route | grep -q "$BRIDGE_SUBNET"; then
            info "Subnet $BRIDGE_SUBNET conflicts with existing route, finding alternative..."
            find_free_subnet 4
        fi

        if ip -6 route list table all | grep -q "$BRIDGE_SUBNET6"; then
            info "Subnet $BRIDGE_SUBNET6 conflicts with existing route, finding alternative..."
            find_free_subnet 6
        fi
    fi

    setup_bridge

    [ "${ANDROID:-}" = "1" ] && setup_android_routing

    if [ -e "$NETNS_DIR/$NETNS_NAME" ]; then
        CT_IP=$(ip netns exec "$NETNS_NAME" ip -4 addr show "eth0_${VETH_NAME}" 2>/dev/null | \
                awk '/inet / {print $2}' | cut -d/ -f1 | head -1)

        CT_IP6=$(ip netns exec "$NETNS_NAME" ip -6 addr show "eth0_${VETH_NAME}" 2>/dev/null | \
                awk '/inet6 / && !/fe80/ {print $2}' | cut -d/ -f1 | head -1)

        [ -z "$CT_IP" ] && CT_IP=$(get_next_ip)
    else
        CT_IP=$(get_next_ip)
    fi

    setup_netns "$CT_IP"
    [ -n "${PORT_RANGE:-}" ] && setup_port_forward "$CT_IP"
    [ "${ANDROID:-}" = "1" ] && android_custom_routing "$CT_IP"
    NETNS_ENTER="ip netns exec $NETNS_NAME"
fi

check_ns -p && ARGS="${ARGS:-} -p -f" && PID_NS=1
check_ns -i && ARGS="${ARGS:-} -i" && IPC_NS=1
check_ns -u && ARGS="${ARGS:-} -u" && UTS_NS=1
check_ns -m && ARGS="${ARGS:-} -m" && MOUNT_NS=1

if unshare --root / true 2>/dev/null; then
    ARGS="${ARGS:-} --kill-child"
    check_ns -T && ARGS="${ARGS:-} -T" && TIME_NS=1
    check_ns -C && ARGS="${ARGS:-} -C" && CGROUP_NS=1
fi

# Start phase 2
bootinfo "fase1: exec unshare MOUNT_NS=${MOUNT_NS:-0} ARGS=[$ARGS]"
PHASE2=1; export PHASE2 HOSTNAME UTS_NS USE_NETNS GUI
if [ "${MOUNT_NS:-}" = "1" ]; then
    exec ${NETNS_ENTER:-} unshare $ARGS -- "$0" "$ROOTFS" "$@"
else
    die "Kernel lacks mount namespace support"
fi
