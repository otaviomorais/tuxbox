#!/system/bin/sh
# ensure-x11-clients — Arch-only: garante as libs de CLIENTE X11 que os
# graficos abrem em tempo de execucao para conseguir criar janela no $DISPLAY.
#
# POR QUE SO ARCH:
# O vkmark upstream monta o backend X11 como PLUGIN CARREGAVEL, nao linkado no
# binario (src/meson.build):
#     if build_xcb_ws
#         xcb_ws = shared_module('xcb', ... dependencies: [vulkan_dep, xcb_dep, xcb_icccm_dep] ...)
#     endif
# No Arch o pacote xcb-util-wm e' dependencia OPCIONAL ("for X11 support"), ou
# seja, `pacman -S vkmark` instala o plugin mas NAO as libs que ele dlopen().
# Resultado: o Vulkan roda na GPU (surface headless) e nada aparece no X11 — o
# benchmark funciona "por fora" e a tela fica vazia. No Debian a pilha X11 entra
# como dependencia dura, por isso o mesmo comando abre janela la e nao aqui.
#
# Modo "full" (botao "Instalar binarios") instala tambem os PROGRAMAS de X11
# uteis: openbox (gerenciador de janelas, que o tuxbox sobe sozinho se existir),
# xterm e xorg-xclock (cliente de teste). Cada um e' sondado com `pacman -Si`
# antes: o repo do container pode ser archlinuxarm e nao ter o mesmo conjunto de
# pacotes do Arch oficial, entao o que nao existir e' apenas pulado.
#
# Nao mexe em nenhuma outra distro: sem pacman no rootfs e' no-op.
# Uso: ensure-x11-clients <rootfs> [minimal|full]

ROOTFS="${1:-}"
MODE="${2:-minimal}"
[ -n "$ROOTFS" ] || exit 2
[ -d "$ROOTFS" ] || exit 2
case "$MODE" in
    full|minimal) ;;
    *) MODE="minimal" ;;
esac

# Arch apenas. Qualquer outra distro (Debian/Ubuntu/Alpine/Fedora...) sai intacta.
[ -x "$ROOTFS/usr/bin/pacman" ] || { echo "skip: nao-arch"; exit 0; }

LOG="$ROOTFS/var/log/tuxbox-x11-clients.log"
mkdir -p "$ROOTFS/var/log" 2>/dev/null || true
log() { printf '[x11-clients] %s\n' "$*" >>"$LOG" 2>/dev/null || true; }

# O plugin xcb do vkmark dlopen()a libxcb-icccm e a libxcb; sem elas ele cai
# no plugin headless. Procura em lib/, usr/lib/ e nos dirs multiarch.
lib_present() {
    _base="$1"
    for _p in \
        "$ROOTFS/usr/lib/$_base".* \
        "$ROOTFS/lib/$_base".* \
        "$ROOTFS/usr/lib/aarch64-linux-gnu/$_base".* \
        "$ROOTFS/usr/lib/arm-linux-gnueabihf/$_base".* \
        "$ROOTFS/usr/lib/musl/$_base".*
    do
        [ -e "$_p" ] && return 0
    done
    return 1
}

MISSING=""
lib_present libxcb-icccm.so || MISSING="$MISSING xcb-util-wm"
lib_present libxcb.so || MISSING="$MISSING libxcb"

if [ -z "$MISSING" ]; then
    log "ok: libxcb + libxcb-icccm presentes (plugin xcb do vkmark carrega)"
    echo "ok: libs de cliente X11 ja presentes"
    exit 0
fi

log "faltando:$MISSING — instalando via pacman"
missing_in_fs() {
    lib_present libxcb-icccm.so || lib_present libxcb.so
}

# pacman 7 exige Landlock no download sandbox, ausente na maioria dos kernels
# Android. ensure-pacman ja grava DisableSandbox em /etc/pacman.conf; aqui
# repetimos numa copia porque a sessao GUI pode ter rodado antes dele.
STAGE="/.tuxbox-x11-pacman"
HOST_STAGE="$ROOTFS$STAGE"
rm -rf "$HOST_STAGE" 2>/dev/null || true
mkdir -p "$HOST_STAGE/.tuxbox-x11-cache" 2>/dev/null || true
CONF=""

# Mesma politica do ensure-pacman, aplicada na COPIA do conf:
#  - DisableSandbox: pacman 7 exige Landlock no download, ausente em Android.
#  - SigLevel ... TrustAll: a cadeia de confianca das chaves ARM so fica
#    "marginal" no container; sem TrustAll o pacman REJEITA a assinatura dos
#    pacotes do repo e a instalacao falha. Este era o bug: o boot do --gui nao
#    passa pelo ensure-pacman, entao o conf ainda tinha a SigLevel estrita.
relax_conf() {
    _c="$1"
    if grep -q '^\[options\]' "$_c" 2>/dev/null; then
        grep -q '^[[:space:]]*DisableSandbox' "$_c" 2>/dev/null || \
            sed -i '/^\[options\]/a DisableSandbox' "$_c" 2>/dev/null || true
    else
        printf '\n[options]\nDisableSandbox\n' >>"$_c" 2>/dev/null || true
    fi
    if grep -q '^[[:space:]]*SigLevel[[:space:]]*=' "$_c" 2>/dev/null; then
        sed -i 's/^[[:space:]]*SigLevel[[:space:]]*=.*/SigLevel = Required DatabaseOptional TrustAll/' \
            "$_c" 2>/dev/null || true
    else
        printf 'SigLevel = Required DatabaseOptional TrustAll\n' >>"$_c" 2>/dev/null || true
    fi
    if grep -q '^[[:space:]]*LocalFileSigLevel[[:space:]]*=' "$_c" 2>/dev/null; then
        sed -i 's/^[[:space:]]*LocalFileSigLevel[[:space:]]*=.*/LocalFileSigLevel = Optional/' \
            "$_c" 2>/dev/null || true
    else
        printf 'LocalFileSigLevel = Optional\n' >>"$_c" 2>/dev/null || true
    fi
}

if [ -f "$ROOTFS/etc/pacman.conf" ] && [ -d "$HOST_STAGE" ]; then
    cp "$ROOTFS/etc/pacman.conf" "$HOST_STAGE/pacman.conf" 2>/dev/null || true
    if [ -f "$HOST_STAGE/pacman.conf" ]; then
        relax_conf "$HOST_STAGE/pacman.conf"
        CONF="$STAGE/pacman.conf"
    fi
else
    log "AVISO: /etc/pacman.conf ausente — usando o conf padrao do container"
fi

run_pacman() {
    chroot "$ROOTFS" /usr/bin/pacman "$@" \
        --cachedir "$STAGE/.tuxbox-x11-cache" >>"$LOG" 2>&1
}

# Keyring: o boot do --gui nao passa pelo ensure-pacman, entao o keyring pode
# nunca ter sido inicializado. Sem GPGDir o pacman aborta antes de baixar.
if [ ! -d "$ROOTFS/etc/pacman.d/gnupg" ] && [ -x "$ROOTFS/usr/bin/pacman-key" ]; then
    log "keyring ausente — pacman-key --init"
    chroot "$ROOTFS" /usr/bin/pacman-key --init >>"$LOG" 2>&1 || true
    chroot "$ROOTFS" /usr/bin/pacman-key --populate archlinuxarm >>"$LOG" 2>&1 || true
    chroot "$ROOTFS" /usr/bin/pacman-key --lsign-key \
        68B3537F39A313B3E574D06777193F152BDBE6A6 >>"$LOG" 2>&1 || true
fi

rc=1
if [ -n "$CONF" ]; then
    run_pacman --config "$CONF" --disable-sandbox -S --needed --noconfirm \
        xcb-util-wm libxcb && rc=0
fi
if [ "$rc" != "0" ]; then
    # A copia de conf pode ter falhado: tenta o caminho simples (o /etc/pacman.conf ja
    # tratado por ensure-pacman cobre o sandbox).
    run_pacman --disable-sandbox -S --needed --noconfirm xcb-util-wm libxcb && rc=0
fi
if [ "$rc" != "0" ] && missing_in_fs; then
    run_pacman -S --needed --noconfirm xcb-util-wm libxcb && rc=0
fi

rm -rf "$HOST_STAGE" 2>/dev/null || true

# === Modo full: programas de X11 (WM + clientes de teste) ===============
# O tuxbox ja sobe `openbox --sm-disable` sozinho quando o binario existe, e
# sem xterm/xclock nao ha como conferir visualmente se o X11 esta vivo.
install_extras() {
    _want=""
    _skip=""
    # "pacote:arquivo" — o arquivo e' o marcador de "ja instalado".
    for _pair in openbox:usr/bin/openbox \
                 xterm:usr/bin/xterm \
                 xorg-xclock:usr/bin/xclock
    do
        _pkg="${_pair%%:*}"
        _bin="${_pair#*:}"
        if [ -x "$ROOTFS/$_bin" ]; then
            continue
        fi
        # Sonda no repo: pacote inexistente nao deve abortar a instalacao.
        if ! chroot "$ROOTFS" /usr/bin/pacman -Si "$_pkg" >>"$LOG" 2>&1; then
            log "extra $_pkg: ausente no repo deste container — pulado"
            _skip="$_skip $_pkg"
            continue
        fi
        _want="$_want $_pkg"
    done
    if [ -z "$_want" ]; then
        [ -n "$_skip" ] && log "extras: nada a fazer (indisponiveis:$_skip)"
        return 0
    fi
    # shellcheck disable=SC2086
    if run_pacman --disable-sandbox -S --needed --noconfirm $_want; then
        log "extras instalados:$_want"
        return 0
    fi
    # Retry sem a flag (alguns pacman mais antigos nao aceitam --disable-sandbox)
    # shellcheck disable=SC2086
    if run_pacman -S --needed --noconfirm $_want; then
        log "extras instalados (retry):$_want"
        return 0
    fi
    log "extras FALHARAM:$_want"
    return 1
}

if [ "$MODE" = "full" ]; then
    _extras_rc=0
    install_extras || _extras_rc=1
    if [ "$_extras_rc" != "0" ]; then
        warn_note="(extras de X11 falharam; as libs criticas continuam ok)"
    else
        warn_note=""
    fi
else
    warn_note=""
fi

if [ "$rc" = "0" ] || ! missing_in_fs; then
    if [ "$MODE" = "full" ] && [ "$_extras_rc" = "0" ]; then
        log "ok: instalado ($MISSING) + programas de X11$warn_note"
        echo "instalado: libs de cliente X11 ($MISSING) + programas (WM/clientes)$warn_note"
    else
        log "ok: instalado ($MISSING) — plugin xcb do vkmark deve carregar$warn_note"
        echo "instalado: libs de cliente X11 ($MISSING)$warn_note"
    fi
    exit 0
fi

log "FALHOU: $MISSING nao instalados (rc=$rc)"
echo "FALHOU: rode no Arch -> pacman -S --needed --noconfirm xcb-util-wm libxcb"
exit 1
